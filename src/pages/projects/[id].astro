---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

const { data: project, error } = await Astro.locals.supabase
	.from('projects')
	.select('id, name, description, owner_id')
	.eq('id', id)
	.single();

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

const { data: members } = await Astro.locals.supabase
	.from('project_members')
	.select('role, user_id, profiles(display_name, email)')
	.eq('project_id', id)
	.overrideTypes<{ role: string; user_id: string, profiles: { display_name: string; email: string } }[]>();

const userRole = members?.find(member => member.user_id === user.id)?.role;

const { data: files } = await Astro.locals.supabase
	.from('files')
	.select('id, filename, size_bytes, mime_type, created_at, profiles(display_name)')
	.eq('project_id', id)
	.order('created_at', { ascending: false })
	.overrideTypes<{ id: string; filename: string; size_bytes: number | null; mime_type: string | null; created_at: string; profiles: { display_name: string } }[]>()
---
<BaseLayout title={project.name}>
	<h1>{project.name}</h1>
	{project.description && <p>{project.description}</p>}
	<p><a href="/projects">← Back to projects</a></p>

	<h2>Members</h2>
	<ul>
		{members?.map((m) => (
			<li>{m.profiles?.display_name} ({m.profiles?.email}) — {m.role}</li>
		))}
	</ul>

	<h2>Files</h2>
	{files && files.length === 0 && <p>No files yet.</p>}
	<ul id="file-list">
		{files?.map((f) => (
			<li>
				<button type="button" class="download-btn" data-file-id={f.id} data-filename={f.filename}>{f.filename}</button>
				— {f.size_bytes != null ? `${Math.round(f.size_bytes).toLocaleString()} B` : ''} — uploaded by {f.profiles?.display_name}
			</li>
		))}
	</ul>

	{userRole === 'owner' && (
		<>
			<h2>Add a member</h2>
			<form method="POST" action={`/api/projects/${project.id}/members`} onsubmit="this.querySelector('button').disabled = true">
				<input type="email" name="email" placeholder="User's email" required />
				<select name="role">
					<option value="editor">Editor</option>
					<option value="viewer">Viewer</option>
				</select>
				<button type="submit">Add</button>
			</form>
		</>
	)}

	{(userRole === 'owner' || userRole === 'editor') && (
	<>
		<h2>Upload a file</h2>
		<form id="upload-form">
			<input type="file" id="file-input" required />
			<button type="submit">Upload</button>
		</form>
		<p id="upload-status"></p>
	</>
)}
</BaseLayout>

<script define:vars={{ projectId: project.id }} is:inline>
	const form = document.getElementById('upload-form');
	const status = document.getElementById('upload-status');

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const fileInput = document.getElementById('file-input');
			const file = fileInput.files[0];
			if (!file) return;

			status.textContent = 'Requesting upload URL...';

			const urlRes = await fetch(`/api/projects/${projectId}/files/upload-url`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ filename: file.name }),
			});

			if (!urlRes.ok) {
				status.textContent = 'Failed to get upload URL: ' + (await urlRes.text());
				return;
			}

			const { uploadUrl, r2Key } = await urlRes.json();

			status.textContent = 'Uploading...';

			const putRes = await fetch(uploadUrl, {
				method: 'PUT',
				body: file,
			});

			if (!putRes.ok) {
				status.textContent = 'Upload to R2 failed';
				return;
			}

			status.textContent = 'Saving file record...';

			const confirmRes = await fetch(`/api/projects/${projectId}/files/confirm`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					r2Key,
					filename: file.name,
					size: file.size,
					mimeType: file.type,
				}),
			});

			if (confirmRes.ok) {
				status.textContent = 'Upload complete!';
				location.reload();
			} else {
				const result = await confirmRes.json();
				status.textContent = result.cleanedUp
					? `Upload failed (cleaned up): ${result.error}`
					: `Upload failed AND cleanup failed: ${result.error}`;
			}
		});
	}
	
	document.getElementById('file-list')?.addEventListener('click', async (e) => {
		console.log('clicked:', e.target);
		const target = e.target;
		if (!target.classList || !target.classList.contains('download-btn')) {
			console.log('not a download button, ignoring');
			return;
		}

		const fileId = target.dataset.fileId;
		const originalText = target.dataset.filename ?? '';
		target.textContent = 'Loading...';

		const res = await fetch(`/api/files/${fileId}/download-url`);

		if (!res.ok) {
			alert('Failed to get download link');
			target.textContent = originalText;
			return;
		}

		const { downloadUrl } = await res.json();
		window.location.href = downloadUrl;
	});

</script>