---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectShell from '../../components/ProjectShell.astro';
import TotalCostDisplay from '../../components/TotalCostDisplay.svelte';
import ProjectDescriptionEditor from '../../components/ProjectDescriptionEditor.svelte';
import ProjectStorageUsed from '../../components/ProjectStorageUsed.svelte';
import { getProjectStorageBytes } from '../../lib/r2-quota';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

// Fired together rather than in sequence: the Worker is a long trip from
// Postgres and none of these depend on the one before it (RLS scopes each to
// the caller independently), so the 404 check just moves below the await.
const [{ data: project, error }, { data: members }, { data: bomItems }, { totalBytes: projectStorageBytes, failed: projectStorageFailed }] =
	await Promise.all([
		Astro.locals.supabase
			.from('projects')
			.select('id, name, description, owner_id')
			.eq('id', id)
			.single(),
		Astro.locals.supabase
			.from('project_members')
			.select('role, is_auditor, user_id, profiles(display_name, email)')
			.eq('project_id', id)
			.overrideTypes<{ role: string; is_auditor: boolean; user_id: string; profiles: { display_name: string; email: string } }[]>(),
		Astro.locals.supabase
			.from('bom_items')
			.select('total_cost')
			.eq('project_id', id),
		getProjectStorageBytes(Astro.locals.supabase, id!),
	]);

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

const userRole = members?.find(member => member.user_id === user.id)?.role;
const isOwner = userRole === 'owner';

const totalCost = (bomItems ?? []).reduce((sum, item) => sum + (item.total_cost ?? 0), 0);
---
<BaseLayout title={project.name}>
	<ProjectShell project={project} members={members ?? []} userRole={userRole} activePage="overview">
		<div class="overview-layout">
			<div class="overview-main">
				<ProjectDescriptionEditor
					client:load
					projectId={project.id}
					initialDescription={project.description}
					canEdit={isOwner}
				/>
			</div>
			<div class="overview-stats">
				<TotalCostDisplay client:load totalCost={totalCost} />
				<ProjectStorageUsed client:load initialUsedBytes={projectStorageBytes} initialFailed={projectStorageFailed} />
			</div>
		</div>
	</ProjectShell>
</BaseLayout>

<style>
	.overview-layout {
		display: flex;
		gap: var(--space-5);
	}

	.overview-main {
		flex: 1 1 auto;
		min-width: 0;
	}

	.overview-stats {
		flex: 0 0 240px;
		min-width: 0;
	}

	@media (max-width: 768px) {
		.overview-layout {
			flex-direction: column;
		}
	}
</style>
