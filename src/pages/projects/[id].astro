---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TotalCostDisplay from '../../components/TotalCostDisplay.svelte';
import ProjectDescriptionEditor from '../../components/ProjectDescriptionEditor.svelte';
import ProjectStorageUsed from '../../components/ProjectStorageUsed.svelte';
import DownloadProjectButton from '../../components/DownloadProjectButton.svelte';
import UpcomingTasks from '../../components/UpcomingTasks.svelte';
import { getProjectStorageBytes } from '../../lib/r2-quota';
import { TASK_COLUMNS, normalizeTask, type RawTaskRow } from '../../lib/task-columns';
import { isCategoryColorIndex, type CategoryColors } from '../../lib/category-color';
import { HORIZON_COOKIE, parseHorizonDays } from '../../lib/task-horizon';
import { projectReminders } from '../../lib/reminders';
import { listGhostMembers } from '../../lib/ghost-members';
import { appNowTime, appToday } from '../../lib/today';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

const [
	{ data: project, error },
	{ data: members },
	ghostMembers,
	{ data: bomItems },
	{ totalBytes: projectStorageBytes, failed: projectStorageFailed },
	{ data: taskRows },
	{ data: categoryRows },
] = await Promise.all([
		Astro.locals.supabase
			.from('projects')
			.select('id, name, description, owner_id, currency')
			.eq('id', id)
			.single(),
		Astro.locals.supabase
			.from('project_members')
			.select('role, is_auditor, user_id, profiles(display_name, email)')
			.eq('project_id', id)
			.overrideTypes<{ role: string; is_auditor: boolean; user_id: string; profiles: { display_name: string; email: string } }[]>(),
		listGhostMembers(Astro.locals.supabase, id!),
		Astro.locals.supabase
			.from('bom_items')
			.select('total_cost')
			.eq('project_id', id)
			.is('deleted_at', null),
		getProjectStorageBytes(Astro.locals.supabase, id!),
		Astro.locals.supabase
			.from('tasks')
			.select(TASK_COLUMNS)
			.eq('project_id', id)
			.is('deleted_at', null)
			.neq('status', 'done')
			.not('deadline', 'is', null)
			.order('deadline', { ascending: true })
			.order('deadline_time', { ascending: true })
			.order('name', { ascending: true })
			.overrideTypes<RawTaskRow[]>(),
		Astro.locals.supabase
			.from('task_categories')
			.select('name, color_index')
			.eq('project_id', id)
			.overrideTypes<{ name: string; color_index: number }[]>(),
	]);

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

const userRole = members?.find(member => member.user_id === user.id)?.role;
const isOwner = userRole === 'owner';

const totalCost = (bomItems ?? []).reduce((sum, item) => sum + (item.total_cost ?? 0), 0);

const categoryColors: CategoryColors = {};
for (const row of categoryRows ?? []) {
	if (isCategoryColorIndex(row.color_index)) categoryColors[row.name] = row.color_index;
}

const reminders = projectReminders((taskRows ?? []).map(normalizeTask), id!, categoryColors, user.id);

const horizonDays = parseHorizonDays(Astro.cookies.get(HORIZON_COOKIE)?.value);

const serverToday = appToday();
const serverNowTime = appNowTime();

const ROLE_ORDER = ['owner', 'editor', 'viewer'];
const ROLE_LABELS: Record<string, string> = { owner: 'Owner', editor: 'Editors', viewer: 'Viewers' };

const roles = [...new Set((members ?? []).map((m) => m.role))].sort((a, b) => {
	const ai = ROLE_ORDER.indexOf(a);
	const bi = ROLE_ORDER.indexOf(b);
	return (ai === -1 ? ROLE_ORDER.length : ai) - (bi === -1 ? ROLE_ORDER.length : bi);
});

const memberGroups = roles.map((role) => ({
	role,
	label: ROLE_LABELS[role] ?? role,
	members: (members ?? []).filter((m) => m.role === role),
}));
---
<BaseLayout title={project.name} projectNav={{ projectId: project.id, userRole: userRole ?? '' }}>
	<section class="overview-description">
		<ProjectDescriptionEditor
			client:load
			projectId={project.id}
			initialDescription={project.description}
			canEdit={isOwner}
		/>
	</section>

	<div class="overview-columns">
		<section class="overview-members">
			<h2>Members</h2>
			<table class="members-table">
				<tbody>
					{memberGroups.map((group) =>
						group.members.map((m) => (
							<tr>
								<td class="member-role">{group.label === 'Owner' ? 'Owner' : group.label.replace(/s$/, '')}</td>
								<td>
									{m.profiles?.display_name}
									{m.is_auditor && <span class="muted"> [auditor]</span>}
								</td>
							</tr>
						))
					)}
					{ghostMembers.length > 0 && ghostMembers.map((g) => (
						<tr>
							<td class="member-role muted">Ghost</td>
							<td class="muted">
								{g.display_name}
								{g.is_deleted_account && <span> [deleted]</span>}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</section>

		<section class="overview-faqs">
			<h2>Quick FAQs</h2>
			<TotalCostDisplay client:load totalCost={totalCost} currency={project.currency} />
			<ProjectStorageUsed client:load initialUsedBytes={projectStorageBytes} initialFailed={projectStorageFailed} />
			<DownloadProjectButton client:load projectId={project.id} />
		</section>
	</div>

	<section class="overview-reminders">
		<UpcomingTasks
			client:load
			reminders={reminders}
			initialHorizonDays={horizonDays}
			serverToday={serverToday}
			serverNowTime={serverNowTime}
			showMineFilter={true}
		/>
	</section>
</BaseLayout>

<style>
	.overview-description {
		margin-bottom: var(--space-4);
	}

	.overview-columns {
		display: flex;
		gap: var(--space-6);
	}

	.overview-members {
		flex: 1;
		min-width: 0;
	}

	.overview-faqs {
		flex: 0 0 280px;
		min-width: 0;
	}

	.members-table {
		width: 100%;
		border-collapse: collapse;
		margin: 0;
	}

	.members-table td {
		padding: var(--space-1) var(--space-3);
		border-bottom: none;
		vertical-align: top;
	}

	.member-role {
		white-space: nowrap;
		color: var(--color-muted);
		width: 80px;
	}

	.overview-reminders {
		margin-top: var(--space-4);
	}

	@media (max-width: 768px) {
		.overview-columns {
			flex-direction: column;
			gap: var(--space-4);
		}

		.overview-faqs {
			flex-basis: auto;
		}
	}
</style>
