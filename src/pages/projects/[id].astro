---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FileBrowser from '../../components/FileBrowser.svelte';
import BomTable from '../../components/BomTable.svelte';
import MembersPanel from '../../components/MembersPanel.astro';
import UploadForm from '../../components/UploadForm.svelte';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

const { data: project, error } = await Astro.locals.supabase
	.from('projects')
	.select('id, name, description, owner_id')
	.eq('id', id)
	.single();

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

const { data: members } = await Astro.locals.supabase
	.from('project_members')
	.select('role, user_id, profiles(display_name, email)')
	.eq('project_id', id)
	.overrideTypes<{ role: string; user_id: string, profiles: { display_name: string; email: string } }[]>();

const userRole = members?.find(member => member.user_id === user.id)?.role;
const canEdit = userRole === 'owner' || userRole === 'editor';

const currentFolderId = Astro.url.searchParams.get('folder');

const { data: allFolders } = await Astro.locals.supabase
	.from('folders')
	.select('id, name, parent_folder_id')
	.eq('project_id', id);

const folderById = new Map((allFolders ?? []).map((f) => [f.id, f]));

if (currentFolderId && !folderById.has(currentFolderId)) {
	return new Response('Folder not found', { status: 404 });
}

let filesQuery = Astro.locals.supabase
	.from('files')
	.select('id, filename, size_bytes, mime_type, created_at, profiles(display_name)')
	.eq('project_id', id)
	.order('created_at', { ascending: false });

filesQuery = currentFolderId ? filesQuery.eq('folder_id', currentFolderId) : filesQuery.is('folder_id', null);

const { data: files } = await filesQuery
	.overrideTypes<{ id: string; filename: string; size_bytes: number | null; mime_type: string | null; created_at: string; profiles: { display_name: string } }[]>()

const { data: bomItems } = await Astro.locals.supabase
	.from('bom_items')
	.select('id, part_name, description, quantity, unit, unit_cost, supplier, item_url, total_cost')
	.eq('project_id', id)
	.order('created_at', { ascending: true });
---
<BaseLayout title={project.name}>
	<h1>{project.name}</h1>
	{project.description && <p class="muted">{project.description}</p>}
	<p><a href="/projects">← Back to projects</a></p>

	<MembersPanel projectId={project.id} members={members ?? []} userRole={userRole} />

	<h2>Files</h2>

	<FileBrowser
		client:load
		projectId={project.id}
		canEdit={canEdit}
		initialAllFolders={allFolders ?? []}
		initialFolderId={currentFolderId}
		initialFiles={files ?? []}
	/>

	<BomTable client:load projectId={project.id} initialItems={bomItems ?? []} canEdit={canEdit} />

	{canEdit && <UploadForm client:load projectId={project.id} currentFolderId={currentFolderId} />}
</BaseLayout>