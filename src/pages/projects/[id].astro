---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectShell from '../../components/ProjectShell.astro';
import TotalCostDisplay from '../../components/TotalCostDisplay.svelte';
import { getProjectStorageBytes } from '../../lib/r2-quota';
import { formatBytes } from '../../lib/format-bytes';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

const { data: project, error } = await Astro.locals.supabase
	.from('projects')
	.select('id, name, description, owner_id')
	.eq('id', id)
	.single();

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

const { data: members } = await Astro.locals.supabase
	.from('project_members')
	.select('role, user_id, profiles(display_name, email)')
	.eq('project_id', id)
	.overrideTypes<{ role: string; user_id: string, profiles: { display_name: string; email: string } }[]>();

const userRole = members?.find(member => member.user_id === user.id)?.role;

const { data: bomItems } = await Astro.locals.supabase
	.from('bom_items')
	.select('total_cost')
	.eq('project_id', id);

const totalCost = (bomItems ?? []).reduce((sum, item) => sum + (item.total_cost ?? 0), 0);

const projectStorageBytes = await getProjectStorageBytes(Astro.locals.supabase, id!);
---
<BaseLayout title={project.name}>
	<ProjectShell project={project} members={members ?? []} userRole={userRole} activePage="overview">
		<h2>Overview</h2>
		<TotalCostDisplay client:load totalCost={totalCost} />
		<p class="project-storage-total">Project storage used: {formatBytes(projectStorageBytes)}</p>
	</ProjectShell>
</BaseLayout>

<style>
	.project-storage-total {
		font-size: 0.85rem;
		color: var(--color-muted);
	}
</style>
