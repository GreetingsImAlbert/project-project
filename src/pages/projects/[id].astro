---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TotalCostDisplay from '../../components/TotalCostDisplay.svelte';
import ProjectDescriptionEditor from '../../components/ProjectDescriptionEditor.svelte';
import ProjectStorageUsed from '../../components/ProjectStorageUsed.svelte';
import DownloadProjectButton from '../../components/DownloadProjectButton.svelte';
import UpcomingTasks from '../../components/UpcomingTasks.svelte';
import Avatar from '../../components/Avatar.svelte';
import { getProjectStorageBytes } from '../../lib/r2-quota';
import { TASK_COLUMNS, normalizeTask, type RawTaskRow } from '../../lib/task-columns';
import { isCategoryColorIndex, type CategoryColors } from '../../lib/category-color';
import { HORIZON_COOKIE, parseHorizonDays } from '../../lib/task-horizon';
import { projectReminders } from '../../lib/reminders';
import { listGhostMembers } from '../../lib/ghost-members';
import { appNowTime, appToday } from '../../lib/today';
import { type CurrencyCode } from '../../lib/currency';

export const prerender = false;

const user = Astro.locals.user;
const { id } = Astro.params;

// Two access paths (see SCHEMA.md, "Public project boundary"). Guests and
// authenticated non-members only ever read the id/name/description slice
// through public_project_get, which filters on is_public; a private or
// nonexistent project is the same 404, so private-project membership never
// leaks to outsiders. Members keep the full RLS queries and UI below.
let publicProject: { id: string; name: string; description: string | null } | null = null;

if (!user) {
	const { data } = await Astro.locals.supabase.rpc('public_project_get', { p_id: id! });
	publicProject = data?.[0] ?? null;
	if (!publicProject) {
		return new Response('Project not found', { status: 404 });
	}
}

let project: { id: string; name: string; description: string | null; owner_id: string; currency: string } | null = null;
let members: { role: string; is_auditor: boolean; user_id: string; profiles: { display_name: string; email: string; avatar: string | null } | null }[] | null = null;
let ghostMembers: Awaited<ReturnType<typeof listGhostMembers>> = [];
let totalCost = 0;
let categoryColors: CategoryColors = {};
let reminders: ReturnType<typeof projectReminders> = [];
let projectStorageBytes = 0;
let projectStorageFailed = false;
let userRole: string | undefined;
let isOwner = false;

if (user) {
	const [
		{ data: projectData, error },
		{ data: membersData },
		ghostMembersData,
		{ data: bomItems },
		{ totalBytes, failed },
		{ data: taskRows },
		{ data: categoryRows },
	] = await Promise.all([
		Astro.locals.supabase
			.from('projects')
			.select('id, name, description, owner_id, currency')
			.eq('id', id)
			.single(),
		Astro.locals.supabase
			.from('project_members')
			.select('role, is_auditor, user_id, profiles(display_name, email, avatar)')
			.eq('project_id', id)
			.overrideTypes<{ role: string; is_auditor: boolean; user_id: string; profiles: { display_name: string; email: string; avatar: string | null } }[]>(),
		listGhostMembers(Astro.locals.supabase, id!),
		Astro.locals.supabase
			.from('bom_items')
			.select('total_cost')
			.eq('project_id', id)
			.is('deleted_at', null),
		getProjectStorageBytes(Astro.locals.supabase, id!),
		Astro.locals.supabase
			.from('tasks')
			.select(TASK_COLUMNS)
			.eq('project_id', id)
			.is('deleted_at', null)
			.neq('status', 'done')
			.not('deadline', 'is', null)
			.order('deadline', { ascending: true })
			.order('deadline_time', { ascending: true })
			.order('name', { ascending: true })
			.overrideTypes<RawTaskRow[]>(),
		Astro.locals.supabase
			.from('task_categories')
			.select('name, color_index')
			.eq('project_id', id)
			.overrideTypes<{ name: string; color_index: number }[]>(),
	]);

	if (error || !projectData) {
		// Authenticated non-member: RLS shows no project row. Try the public
		// boundary before deciding it's missing.
		const { data } = await Astro.locals.supabase.rpc('public_project_get', { p_id: id! });
		publicProject = data?.[0] ?? null;
		if (!publicProject) {
			return new Response('Project not found', { status: 404 });
		}
	} else {
		project = projectData;
		members = membersData;
		ghostMembers = ghostMembersData;
		projectStorageBytes = totalBytes;
		projectStorageFailed = failed;
		userRole = membersData?.find((member) => member.user_id === user.id)?.role;
		isOwner = userRole === 'owner';
		totalCost = (bomItems ?? []).reduce((sum, item) => sum + (item.total_cost ?? 0), 0);
		for (const row of categoryRows ?? []) {
			if (isCategoryColorIndex(row.color_index)) categoryColors[row.name] = row.color_index;
		}
		reminders = projectReminders((taskRows ?? []).map(normalizeTask), id!, categoryColors, user.id);
	}
}

const horizonDays = parseHorizonDays(Astro.cookies.get(HORIZON_COOKIE)?.value);

const serverToday = appToday();
const serverNowTime = appNowTime();

const ROLE_ORDER = ['owner', 'editor', 'viewer'];
const ROLE_LABELS: Record<string, string> = { owner: 'Owner', editor: 'Editors', viewer: 'Viewers' };

const roles = [...new Set((members ?? []).map((m) => m.role))].sort((a, b) => {
	const ai = ROLE_ORDER.indexOf(a);
	const bi = ROLE_ORDER.indexOf(b);
	return (ai === -1 ? ROLE_ORDER.length : ai) - (bi === -1 ? ROLE_ORDER.length : bi);
});

const memberGroups = roles.map((role) => ({
	role,
	label: ROLE_LABELS[role] ?? role,
	members: (members ?? []).filter((m) => m.role === role),
}));
---
{publicProject && (
	<BaseLayout title={publicProject.name}>
		<h1 class="public-title">{publicProject.name}</h1>
		<section class="overview-description">
			<div class="overview-heading">
				<h2>Description</h2>
			</div>
			<p class="muted description-text">{publicProject.description || 'No description yet.'}</p>
		</section>
	</BaseLayout>
)}
{!publicProject && (
	<BaseLayout title={project!.name} projectNav={{ projectId: project!.id, userRole: userRole ?? '' }}>
		<section class="overview-description">
			<ProjectDescriptionEditor
				client:load
				projectId={project!.id}
				initialDescription={project!.description}
				canEdit={isOwner}
			/>
		</section>

		<div class="overview-columns">
			<div class="overview-column-main">
				<section class="overview-members">
					<h2>Members</h2>
					<!-- The role is said once, as the heading of its own group, and the members
					     under it are indented rather than each repeating it in a column of its
					     own. Each carries their picture ahead of the name — Avatar falls back to
					     the initial, so a member who never picked one still gets the same shape. -->
					<div class="member-groups">
						{memberGroups.map((group) => (
							<div class="member-group">
								<p class="member-role">{group.label}</p>
								<ul class="member-list">
									{group.members.map((m) => (
										<li class="member">
											<Avatar avatar={m.profiles?.avatar} displayName={m.profiles?.display_name ?? ''} size={24} />
											<span class="member-name">{m.profiles?.display_name}</span>
											{m.is_auditor && <span class="member-tag">auditor</span>}
										</li>
									))}
								</ul>
							</div>
						))}
						{ghostMembers.length > 0 && (
							<div class="member-group">
								<p class="member-role">Ghosts</p>
								<ul class="member-list">
									{ghostMembers.map((g) => (
										<li class="member">
											<Avatar avatar={null} displayName={g.display_name} size={24} />
											<span class="member-name muted">{g.display_name}</span>
											{g.is_deleted_account && <span class="member-tag">deleted</span>}
										</li>
									))}
								</ul>
							</div>
						)}
					</div>
				</section>

				<section class="overview-reminders">
					<UpcomingTasks
						client:load
						reminders={reminders}
						initialHorizonDays={horizonDays}
						serverToday={serverToday}
						serverNowTime={serverNowTime}
						showMineFilter={true}
					/>
				</section>
			</div>

			<section class="overview-faqs">
				<h2>Quick FAQs</h2>
				<TotalCostDisplay client:visible totalCost={totalCost} currency={project!.currency as CurrencyCode} />
				<ProjectStorageUsed client:visible initialUsedBytes={projectStorageBytes} initialFailed={projectStorageFailed} />
				<DownloadProjectButton client:visible projectId={project!.id} />
			</section>
		</div>
	</BaseLayout>
)}

<style>
	.public-title {
		margin-top: 0;
		margin-bottom: var(--space-4);
	}

	/* Mirrors the member overview's description block, minus the editor and
	   the expand/collapse JS — a plain read-only version of the same text. */
	.overview-heading h2 {
		margin-top: 0;
		padding-top: 0;
		border-top: none;
	}

	.description-text {
		white-space: pre-wrap;
		margin: 0;
	}

	.overview-description {
		margin-bottom: var(--space-4);
	}

	.overview-columns {
		display: flex;
		gap: var(--space-6);
		align-items: flex-start;
	}

	/* Members and Reminders stack in the reading column; Quick FAQs is its own. */
	.overview-column-main {
		flex: 1;
		min-width: 0;
	}

	.overview-faqs {
		flex: 0 0 280px;
		min-width: 0;
	}

	/* No dividers anywhere on this page — the sections are already set apart by
	   whitespace and the column split. */
	.overview-members h2,
	.overview-faqs h2 {
		margin-top: 0;
		padding-top: 0;
		border-top: none;
	}

	.member-groups {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	/* Same small-caps label the panels elsewhere use for a field name — it's a heading
	   for the rows under it, not a value beside them. */
	.member-role {
		margin: 0 0 var(--space-1);
		color: var(--color-muted);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.member-list {
		list-style: none;
		margin: 0;
		padding-left: var(--space-3);
	}

	.member {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: 2px 0;
		min-width: 0;
	}

	.member-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.member-tag {
		color: var(--color-muted);
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.overview-reminders {
		margin-top: var(--space-4);
	}

	@media (max-width: 768px) {
		.overview-columns {
			flex-direction: column;
			gap: var(--space-4);
		}

		.overview-faqs {
			flex-basis: auto;
		}
	}
</style>
