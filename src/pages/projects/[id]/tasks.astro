---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TasksSummary from '../../../components/TasksSummary.svelte';
import TasksTable from '../../../components/TasksTable.svelte';
import {
	TASK_CATEGORY_POSITION_COLUMNS,
	TASK_COLUMNS,
	TASK_SORT_MODE_COOKIE,
	isTaskSortMode,
	normalizeTask,
	type RawTaskRow,
	type Task,
	type TaskCategoryPosition,
	type TaskSortMode,
} from '../../../lib/task-columns';
import { isCategoryColorIndex, type CategoryColors } from '../../../lib/category-color';
import { listGhostMembers } from '../../../lib/ghost-members';
import { appNowTime, appToday } from '../../../lib/today';
import { summarizeTasks } from '../../../lib/task-summary';
import { getPublicProjectGate, toPublicSectionFlags, type PublicProjectFlags } from '../../../lib/project-visibility';
import { getSupabaseAdmin } from '../../../lib/supabase/admin';

export const prerender = false;

const user = Astro.locals.user;
const { id } = Astro.params;

type TasksProject = {
	id: string;
	name: string;
	description: string | null;
	owner_id: string | null;
} & PublicProjectFlags;

type MemberRow = {
	role: string;
	is_auditor: boolean;
	user_id: string;
	profiles: { display_name: string; email: string; avatar: string | null };
};

let project: TasksProject | null = null;
let publicReader = false;
let members: MemberRow[] = [];
let ghostMembers: Awaited<ReturnType<typeof listGhostMembers>> = [];
let taskRows: RawTaskRow[] = [];
let categoryPositionRows: TaskCategoryPosition[] = [];
let categoryRows: { name: string; color_index: number }[] = [];

// Members are always resolved through the caller's RLS view first. This keeps the
// existing role-aware branch unchanged and makes an authenticated non-member
// indistinguishable from a guest before the public gate is consulted.
if (user) {
	const { data: projectData, error } = await Astro.locals.supabase
		.from('projects')
		.select('id, name, description, owner_id, is_public, public_files_enabled, public_tasks_enabled, public_journal_enabled, public_money_enabled')
		.eq('id', id)
		.single()
		.overrideTypes<TasksProject>();

	if (!error && projectData) {
		project = projectData;

		// These queries are independent once membership is established. Keep the
		// member branch's existing RLS-scoped payload and ordering intact.
		const [
			{ data: membersData },
			ghostMembersData,
			{ data: memberTaskRows },
			{ data: memberCategoryPositionRows },
			{ data: memberCategoryRows },
		] = await Promise.all([
			Astro.locals.supabase
				.from('project_members')
				.select('role, is_auditor, user_id, profiles(display_name, email, avatar)')
				.eq('project_id', id)
				.overrideTypes<MemberRow[]>(),
			listGhostMembers(Astro.locals.supabase, id!),
			Astro.locals.supabase
				.from('tasks')
				.select(TASK_COLUMNS)
				.eq('project_id', id)
				.is('deleted_at', null)
				.order('deadline', { ascending: true, nullsFirst: false })
				.order('deadline_time', { ascending: true })
				.order('name', { ascending: true })
				.overrideTypes<RawTaskRow[]>(),
			Astro.locals.supabase
				.from('task_category_positions')
				.select(TASK_CATEGORY_POSITION_COLUMNS)
				.eq('project_id', id)
				.order('priority_position', { ascending: true })
				.order('id', { ascending: true })
				.overrideTypes<TaskCategoryPosition[]>(),
			Astro.locals.supabase
				.from('task_categories')
				.select('name, color_index')
				.eq('project_id', id)
				.overrideTypes<{ name: string; color_index: number }[]>(),
		]);

		members = membersData ?? [];
		ghostMembers = ghostMembersData;
		taskRows = memberTaskRows ?? [];
		categoryPositionRows = memberCategoryPositionRows ?? [];
		categoryRows = memberCategoryRows ?? [];
	}
}

if (!project) {
	const admin = getSupabaseAdmin(env);
	const gate = await getPublicProjectGate(admin, id, 'tasks');
	if (!gate) {
		return new Response('Project not found', { status: 404 });
	}

	// Public queries select only task display fields, category presentation data, and
	// the names/avatars needed by the read-only task view. Internal assignee IDs are
	// redacted before the payload reaches the island below.
	const [
		{ data: publicTaskRows, error: tasksError },
		{ data: publicCategoryPositionRows, error: positionsError },
		{ data: publicCategoryRows, error: categoriesError },
	] = await Promise.all([
		admin
			.from('tasks')
			.select(TASK_COLUMNS)
			.eq('project_id', gate.id)
			.is('deleted_at', null)
			.order('deadline', { ascending: true, nullsFirst: false })
			.order('deadline_time', { ascending: true })
			.order('name', { ascending: true })
			.overrideTypes<RawTaskRow[]>(),
		admin
			.from('task_category_positions')
			.select(TASK_CATEGORY_POSITION_COLUMNS)
			.eq('project_id', gate.id)
			.order('priority_position', { ascending: true })
			.order('id', { ascending: true })
			.overrideTypes<TaskCategoryPosition[]>(),
		admin
			.from('task_categories')
			.select('name, color_index')
			.eq('project_id', gate.id)
			.overrideTypes<{ name: string; color_index: number }[]>(),
	]);

	if (tasksError || positionsError || categoriesError) {
		return new Response('Could not load tasks', { status: 500 });
	}

	project = { ...gate, description: null, owner_id: null };
	publicReader = true;
	taskRows = publicTaskRows ?? [];
	categoryPositionRows = publicCategoryPositionRows ?? [];
	categoryRows = publicCategoryRows ?? [];
}

const currentMember = members.find((member) => member.user_id === user?.id);
const userRole = currentMember?.role;
// Tasks follow base editor rights, not Money's owner-or-auditor rule. Public readers
// always stay read-only even if the request carries an authenticated identity.
const canEdit = !publicReader && (userRole === 'owner' || userRole === 'editor');

// `avatar` rides along for the appointment picker in the member task panel. Public
// readers receive empty picker arrays; their task rows retain only display names and
// avatars for the read-only assignee column/detail panel.
const memberOptions = members.map((member) => ({
	id: member.user_id,
	displayName: member.profiles.display_name,
	avatar: member.profiles.avatar,
}));
const ghostOptions = ghostMembers.map((ghost) => ({ id: ghost.id, displayName: ghost.display_name }));

const tasks = taskRows.map(normalizeTask);
const publicTasks: Task[] = publicReader
	? tasks.map((task) => ({
			...task,
			assignees: task.assignees.map((assignee, index) => ({
				...assignee,
				id: `public-assignee-${task.id}-${index}`,
				user_id: null,
				ghost_member_id: null,
			})),
		}))
	: tasks;
const publicCategoryPositions: TaskCategoryPosition[] = publicReader
	? categoryPositionRows.map((position, index) => ({ ...position, id: `public-category-${index}` }))
	: categoryPositionRows;

// A row whose index is outside the palette is dropped rather than clamped: it can
// only mean the column drifted from the ten slots tokens.css defines, and falling
// back to the name hash is a real colour where a clamp would be a guess.
const categoryColors: CategoryColors = {};
for (const row of categoryRows) {
	if (isCategoryColorIndex(row.color_index)) categoryColors[row.name] = row.color_index;
}

// Read from cookies rather than left to the client: localStorage is only readable
// after hydration, so the page would render one order and then swap to another.
const storedTaskView = Astro.cookies.get('p2-task-view-mode')?.value;
const initialViewMode = storedTaskView === 'calendar' ? 'calendar' : 'list';
const storedTaskSortMode = Astro.cookies.get(TASK_SORT_MODE_COOKIE)?.value;
const initialTaskSortMode: TaskSortMode = isTaskSortMode(storedTaskSortMode) ? storedTaskSortMode : 'priority';

const storedCollapsed = Astro.cookies.get(`p2-task-collapsed-${id}`)?.value;
let initialCollapsed = ['Done'];
if (storedCollapsed) {
	try {
		const parsed: unknown = JSON.parse(decodeURIComponent(storedCollapsed));
		if (Array.isArray(parsed)) {
			const strings = parsed.filter((category): category is string => typeof category === 'string');
			if (strings.length > 0) initialCollapsed = strings;
		}
	} catch {
		// Leave the default.
	}
}

// One fixed calendar for the whole app, so both islands and the server derive
// identical statuses — see lib/today.ts.
const serverToday = appToday();
const serverNowTime = appNowTime();
const initialSummary = publicReader ? null : summarizeTasks(tasks, serverToday, serverNowTime);
---

<BaseLayout
	title={`${project.name} — Tasks`}
	projectNav={{
		projectId: project.id,
		userRole: userRole ?? '',
		publicNav: publicReader,
		publicSections: toPublicSectionFlags(project),
	}}
>
	{!publicReader && initialSummary && (
		<TasksSummary client:load initialSummary={initialSummary} serverToday={serverToday} serverNowTime={serverNowTime} />
	)}
	<TasksTable
		client:load
		projectId={project.id}
		projectName={project.name}
		initialTasks={publicTasks}
		initialCategoryPositions={publicCategoryPositions}
		initialTaskSortMode={initialTaskSortMode}
		initialCategoryColors={categoryColors}
		initialViewMode={initialViewMode}
		initialCollapsed={initialCollapsed}
		members={publicReader ? [] : memberOptions}
		ghostMembers={publicReader ? [] : ghostOptions}
		canEdit={canEdit}
		readOnly={publicReader}
		currentUserId={publicReader ? null : user?.id ?? null}
		serverToday={serverToday}
		serverNowTime={serverNowTime}
	/>
</BaseLayout>
