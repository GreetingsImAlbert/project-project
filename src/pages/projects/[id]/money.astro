---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectShell from '../../../components/ProjectShell.astro';
import BomTable from '../../../components/BomTable.svelte';
import TransactionsTable from '../../../components/TransactionsTable.svelte';
import MemberContributionsTable from '../../../components/MemberContributionsTable.svelte';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

const { data: project, error } = await Astro.locals.supabase
	.from('projects')
	.select('id, name, description, owner_id')
	.eq('id', id)
	.single();

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

const { data: members } = await Astro.locals.supabase
	.from('project_members')
	.select('role, user_id, contribution_percent, profiles(display_name, email)')
	.eq('project_id', id)
	.overrideTypes<
		{ role: string; user_id: string; contribution_percent: number | null; profiles: { display_name: string; email: string } }[]
	>();

const userRole = members?.find(member => member.user_id === user.id)?.role;
const canEdit = userRole === 'owner' || userRole === 'editor';

const { data: bomItems } = await Astro.locals.supabase
	.from('bom_items')
	.select('id, part_name, category, description, quantity, unit, unit_cost, supplier, item_url, total_cost')
	.eq('project_id', id)
	.order('created_at', { ascending: true });

interface TransactionRow {
	id: string;
	transaction_date: string;
	type: 'item' | 'shipping' | 'discount' | 'refund' | 'payment';
	item_name: string | null;
	quantity: number | null;
	unit: string | null;
	unit_cost: number | null;
	total_cost: number | null;
	member_id: string;
	related_member_id: string | null;
	profiles: { display_name: string } | null;
}

const { data: rawTransactions } = await Astro.locals.supabase
	.from('transactions')
	.select(
		'id, transaction_date, type, item_name, quantity, unit, unit_cost, total_cost, member_id, related_member_id, profiles!transactions_member_id_fkey(display_name)',
	)
	.eq('project_id', id)
	.order('transaction_date', { ascending: true });

// related_member_id isn't in the generated Database types until `npm run update-types`
// is run against the live schema — overrideTypes()'s merge check rejects a field it
// can't see on the base row type, so cast directly instead.
const transactions = rawTransactions as unknown as TransactionRow[] | null;

const memberOptions = (members ?? []).map((member) => ({
	id: member.user_id,
	displayName: member.profiles.display_name,
}));

const contributionMembers = (members ?? []).map((member) => ({
	id: member.user_id,
	displayName: member.profiles.display_name,
	contributionPercent: member.contribution_percent,
}));
---
<BaseLayout title={`${project.name} — Money`}>
	<ProjectShell project={project} members={members ?? []} userRole={userRole} activePage="money">
		<BomTable client:load projectId={project.id} initialItems={bomItems ?? []} canEdit={canEdit} />
		<TransactionsTable
			client:load
			projectId={project.id}
			initialTransactions={transactions ?? []}
			members={memberOptions}
			canEdit={canEdit}
		/>
		<MemberContributionsTable
			client:load
			projectId={project.id}
			members={contributionMembers}
			transactions={transactions ?? []}
			canEdit={canEdit}
		/>
	</ProjectShell>
</BaseLayout>
