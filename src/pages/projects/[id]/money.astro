---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectShell from '../../../components/ProjectShell.astro';
import MoneySummary from '../../../components/MoneySummary.svelte';
import BomTable from '../../../components/BomTable.svelte';
import TransactionsTable from '../../../components/TransactionsTable.svelte';
import MemberContributionsTable from '../../../components/MemberContributionsTable.svelte';
import { TRANSACTION_COLUMNS } from '../../../lib/transaction-columns';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

const { data: project, error } = await Astro.locals.supabase
	.from('projects')
	.select('id, name, description, owner_id')
	.eq('id', id)
	.single();

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

// is_auditor isn't in the generated Database types until `npm run update-types`
// runs, and overrideTypes()'s merge check drops columns it can't see — so select
// it and cast the raw result directly (same pattern as the transactions query).
const { data: rawMembers } = await Astro.locals.supabase
	.from('project_members')
	.select('role, is_auditor, user_id, contribution_percent, profiles(display_name, email)')
	.eq('project_id', id);

const members = rawMembers as unknown as
	{ role: string; is_auditor: boolean; user_id: string; contribution_percent: number | null; profiles: { display_name: string; email: string } }[] | null;

const currentMember = members?.find(member => member.user_id === user.id);
const userRole = currentMember?.role;
// Money-page edit rights = owner OR auditor (a plain editor cannot edit Money).
const canEdit = currentMember?.role === 'owner' || currentMember?.is_auditor === true;

const { data: bomItems } = await Astro.locals.supabase
	.from('bom_items')
	.select('id, part_name, category, description, quantity, unit, unit_cost, supplier, item_url, total_cost')
	.eq('project_id', id)
	.order('created_at', { ascending: true });

interface TransactionRow {
	id: string;
	transaction_date: string;
	type: 'item' | 'shipping' | 'discount' | 'refund' | 'payment' | 'bulk';
	item_name: string | null;
	quantity: number | null;
	unit: string | null;
	unit_cost: number | null;
	supplier: string | null;
	item_url: string | null;
	total_cost: number | null;
	member_id: string;
	related_member_id: string | null;
	group_id: string | null;
	profiles: { display_name: string } | null;
}

const { data: rawTransactions } = await Astro.locals.supabase
	.from('transactions')
	.select(TRANSACTION_COLUMNS)
	.eq('project_id', id)
	.order('transaction_date', { ascending: true });

// related_member_id/supplier aren't in the generated Database types until `npm run update-types`
// is run against the live schema — overrideTypes()'s merge check rejects a field it
// can't see on the base row type, so cast directly instead.
const transactions = rawTransactions as unknown as TransactionRow[] | null;

const memberOptions = (members ?? []).map((member) => ({
	id: member.user_id,
	displayName: member.profiles.display_name,
}));

const contributionMembers = (members ?? []).map((member) => ({
	id: member.user_id,
	displayName: member.profiles.display_name,
	contributionPercent: member.contribution_percent,
}));

// Same default MemberContributionsTable applies when a member has no explicit split
// yet — computed here too so the summary strip and the table agree on first paint.
const initialPercents = Object.fromEntries(
	contributionMembers.map((member) => [member.id, member.contributionPercent ?? 100 / contributionMembers.length]),
);
---
<BaseLayout title={`${project.name} — Money`}>
	<ProjectShell project={project} members={members ?? []} userRole={userRole} activePage="money">
		<MoneySummary
			client:load
			currentUserId={user.id}
			initialItems={bomItems ?? []}
			initialTransactions={transactions ?? []}
			initialPercents={initialPercents}
		/>
		<BomTable client:load projectId={project.id} initialItems={bomItems ?? []} canEdit={canEdit} />
		<TransactionsTable
			client:load
			projectId={project.id}
			initialTransactions={transactions ?? []}
			initialBomItems={bomItems ?? []}
			members={memberOptions}
			canEdit={canEdit}
		/>
		<MemberContributionsTable
			client:load
			projectId={project.id}
			members={contributionMembers}
			transactions={transactions ?? []}
			canEdit={canEdit}
		/>
	</ProjectShell>
</BaseLayout>
