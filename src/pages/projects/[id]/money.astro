---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MoneySummary from '../../../components/MoneySummary.svelte';
import BomTable from '../../../components/BomTable.svelte';
import TransactionsTable from '../../../components/TransactionsTable.svelte';
import MemberContributionsTable from '../../../components/MemberContributionsTable.svelte';
import { TRANSACTION_COLUMNS } from '../../../lib/transaction-columns';
import { resolveContributionPercents } from '../../../lib/money-math';
import { ghostPartyId } from '../../../lib/money-parties';
import { listGhostMembers, type GhostMemberRow } from '../../../lib/ghost-members';
import type { Party } from '../../../lib/parties-store.svelte';
import { getPublicProjectGate, toPublicSectionFlags, type PublicProjectFlags } from '../../../lib/project-visibility';
import { getSupabaseAdmin } from '../../../lib/supabase/admin';
import type { BomItem } from '../../../lib/bom-store.svelte';
import type { CurrencyCode } from '../../../lib/currency';

export const prerender = false;

const user = Astro.locals.user;
const { id } = Astro.params;

type MoneyProject = {
	id: string;
	name: string;
	description: string | null;
	owner_id: string | null;
	currency: CurrencyCode;
} & PublicProjectFlags;

type MemberRow = {
	role: string;
	is_auditor: boolean;
	user_id: string;
	contribution_percent: number | null;
	profiles: { display_name: string } | null;
};

type PublicGhostMemberRow = Pick<GhostMemberRow, 'id' | 'display_name' | 'note' | 'contribution_percent'>;

interface TransactionRow {
	id: string;
	transaction_date: string;
	type: 'item' | 'shipping' | 'discount' | 'refund' | 'payment' | 'bulk';
	item_name: string | null;
	quantity: number | null;
	unit: string | null;
	unit_cost: number | null;
	supplier: string | null;
	item_url: string | null;
	total_cost: number | null;
	member_id: string | null;
	related_member_id: string | null;
	ghost_member_id: string | null;
	related_ghost_member_id: string | null;
	group_id: string | null;
	profiles: { display_name: string } | null;
	ghost_members: { display_name: string } | null;
}

let project: MoneyProject | null = null;
let publicReader = false;
let members: MemberRow[] = [];
let ghostMembers: Array<GhostMemberRow | PublicGhostMemberRow> = [];
let bomItems: BomItem[] = [];
let transactionRows: TransactionRow[] = [];

// Members are resolved through the normal RLS view first. An authenticated
// non-member falls through to the same admin gate as a guest.
if (user) {
	const { data: projectData, error } = await Astro.locals.supabase
		.from('projects')
		.select('id, name, description, owner_id, currency, is_public, public_files_enabled, public_tasks_enabled, public_journal_enabled, public_money_enabled')
		.eq('id', id)
		.single()
		.overrideTypes<MoneyProject>();

	if (!error && projectData) {
		project = projectData;
		const [
			{ data: memberRows },
			memberGhosts,
			{ data: memberBomItems },
			{ data: memberTransactions },
		] = await Promise.all([
			Astro.locals.supabase
				.from('project_members')
				.select('role, is_auditor, user_id, contribution_percent, profiles(display_name)')
				.eq('project_id', id)
				.overrideTypes<MemberRow[]>(),
			listGhostMembers(Astro.locals.supabase, id!),
			Astro.locals.supabase
				.from('bom_items')
				.select('id, part_name, category, description, quantity, unit, unit_cost, supplier, item_url, total_cost')
				.eq('project_id', id)
				.is('deleted_at', null)
				.order('created_at', { ascending: true })
				.overrideTypes<BomItem[]>(),
			// created_at breaks the tie: every line of a bulk transaction carries its parent's
			// date, so ordering by date alone leaves a purchase's own breakdown in whatever order
			// Postgres happens to return it in.
			Astro.locals.supabase
				.from('transactions')
				.select(TRANSACTION_COLUMNS)
				.eq('project_id', id)
				.is('deleted_at', null)
				.order('transaction_date', { ascending: true })
				.order('created_at', { ascending: true })
				.overrideTypes<TransactionRow[]>(),
		]);

		members = memberRows ?? [];
		ghostMembers = memberGhosts;
		bomItems = memberBomItems ?? [];
		transactionRows = memberTransactions ?? [];
	}
}

if (!project) {
	const admin = getSupabaseAdmin(env);
	const gate = await getPublicProjectGate(admin, id, 'money');
	if (!gate) return new Response('Project not found', { status: 404 });

	// The shared gate deliberately omits project-specific money formatting data;
	// fetch only the currency needed by the read-only components after it passes.
	const { data: currencyRow, error: currencyError } = await admin
		.from('projects')
		.select('currency')
		.eq('id', gate.id)
		.maybeSingle()
		.overrideTypes<{ currency: CurrencyCode }>();
	if (currencyError || !currencyRow) return new Response('Project not found', { status: 404 });

	const [
		{ data: publicMembers, error: membersError },
		{ data: publicGhosts, error: ghostsError },
		{ data: publicBomItems, error: bomError },
		{ data: publicTransactions, error: transactionsError },
	] = await Promise.all([
		admin
			.from('project_members')
			.select('user_id, contribution_percent, profiles(display_name)')
			.eq('project_id', gate.id)
			.overrideTypes<{ user_id: string; contribution_percent: number | null; profiles: { display_name: string } | null }[]>(),
		admin
			.from('ghost_members')
			.select('id, display_name, note, contribution_percent')
			.eq('project_id', gate.id)
			.eq('is_deleted_account', false)
			.order('created_at', { ascending: true })
			.overrideTypes<PublicGhostMemberRow[]>(),
		admin
			.from('bom_items')
			.select('id, part_name, category, description, quantity, unit, unit_cost, supplier, item_url, total_cost')
			.eq('project_id', gate.id)
			.is('deleted_at', null)
			.order('created_at', { ascending: true })
			.overrideTypes<BomItem[]>(),
		admin
			.from('transactions')
			.select(TRANSACTION_COLUMNS)
			.eq('project_id', gate.id)
			.is('deleted_at', null)
			.order('transaction_date', { ascending: true })
			.order('created_at', { ascending: true })
			.overrideTypes<TransactionRow[]>(),
	]);

	if (membersError || ghostsError || bomError || transactionsError) {
		return new Response('Could not load money', { status: 500 });
	}

	project = { ...gate, description: null, owner_id: null, currency: currencyRow.currency };
	publicReader = true;
	members = (publicMembers ?? []).map((member) => ({
		role: 'viewer',
		is_auditor: false,
		user_id: member.user_id,
		contribution_percent: member.contribution_percent,
		profiles: member.profiles,
	}));
	ghostMembers = publicGhosts ?? [];
	bomItems = publicBomItems ?? [];
	transactionRows = publicTransactions ?? [];
}

const currentMember = members.find((member) => member.user_id === user?.id);
const userRole = currentMember?.role;
// Money-page edit rights = owner OR auditor (a plain editor cannot edit Money).
const canEdit = !publicReader && (currentMember?.role === 'owner' || currentMember?.is_auditor === true);

// Real members first, ghost members after — one list, because every Money-page number
// is keyed by party id (see money-parties.ts) and the forms offer both as payers.
const parties: Party[] = [
	...members.map((member) => ({
		id: member.user_id,
		displayName: member.profiles?.display_name ?? 'Member',
		isGhost: false,
		note: null,
		contributionPercent: member.contribution_percent,
	})),
	...ghostMembers.map((ghost) => ({
		id: ghostPartyId(ghost.id),
		displayName: ghost.display_name,
		isGhost: true,
		note: ghost.note,
		contributionPercent: ghost.contribution_percent,
	})),
];

// Same resolution MemberContributionsTable applies to an unset split — computed here
// too so the summary strip and the table agree on first paint.
const initialPercents = resolveContributionPercents(parties);
---
<BaseLayout
	title={`${project.name} — Money`}
	projectNav={{
		projectId: project.id,
		userRole: userRole ?? '',
		publicNav: publicReader,
		publicSections: toPublicSectionFlags(project),
	}}
>
	<MoneySummary
		client:load
		currentUserId={publicReader ? null : user?.id ?? null}
		initialItems={bomItems}
		initialTransactions={transactionRows}
		initialPercents={initialPercents}
		currency={project.currency}
	/>
	<BomTable client:visible projectId={project.id} projectName={project.name} initialItems={bomItems} canEdit={canEdit} currency={project.currency} />
	<TransactionsTable
		client:visible
		projectId={project.id}
		projectName={project.name}
		initialTransactions={transactionRows}
		initialBomItems={bomItems}
		initialPercents={initialPercents}
		initialParties={parties}
		canEdit={canEdit}
		currency={project.currency}
	/>
	<MemberContributionsTable
		client:visible
		projectId={project.id}
		projectName={project.name}
		initialParties={parties}
		transactions={transactionRows}
		canEdit={canEdit}
		currency={project.currency}
	/>
</BaseLayout>
