---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JournalPage from '../../../components/JournalPage.svelte';
import JournalHistory from '../../../components/JournalHistory.svelte';
import { getSupabaseAdmin } from '../../../lib/supabase/admin';
import {
	ensureGroupJournal,
	ensureJournalDraft,
	journalSchemaClient,
	loadProjectJournals,
	readJournalObject,
	type ProjectJournal,
} from '../../../lib/journal';
import { parseJournalEntries, type JournalEntry } from '../../../lib/journal-entries';
import { getPublicProjectGate, toPublicSectionFlags, type PublicProjectFlags } from '../../../lib/project-visibility';

export const prerender = false;

const user = Astro.locals.user;
const { id } = Astro.params;

type JournalProject = {
	id: string;
	name: string;
	description: string | null;
	owner_id: string | null;
} & PublicProjectFlags;

const admin = getSupabaseAdmin(env);
let project: JournalProject | null = null;
let userRole: string | undefined;
let publicNav = false;
let readOnly = false;
let entries: JournalEntry[] = [];
let journals: ProjectJournal[] = [];
let initialActiveJournalId: string | null = null;
let canCreatePersonalJournal = false;
let privateJournalManagement: Array<{ fileId: string; filename: string; creatorName: string }> = [];

async function loadPublicEntries(projectId: string): Promise<JournalEntry[] | null> {
	const { data: journalFile, error } = await journalSchemaClient(admin)
		.from('files')
		.select('r2_key')
		.eq('project_id', projectId)
		.eq('is_journal', true)
		.eq('journal_kind', 'group')
		.is('deleted_at', null)
		.maybeSingle();

	if (error) return null;
	const journalContent = journalFile ? await readJournalObject(env, journalFile.r2_key) : '';
	return parseJournalEntries(journalContent).reverse();
}

// A signed-in request gets the normal RLS project row first. Only a member gets
// the member branch; everyone else falls through to the same public gate as a
// guest, so a private project is indistinguishable from a missing one.
if (user) {
	const { data: projectData, error } = await Astro.locals.supabase
		.from('projects')
		.select('id, name, description, owner_id, is_public, public_files_enabled, public_tasks_enabled, public_journal_enabled, public_money_enabled')
		.eq('id', id)
		.single()
		.overrideTypes<JournalProject>();

	if (!error && projectData) {
		const { data: membership } = await Astro.locals.supabase
			.from('project_members')
			.select('role')
			.eq('project_id', projectData.id)
			.eq('user_id', user.id)
			.maybeSingle()
			.overrideTypes<{ role: string }>();

		if (membership) {
			project = projectData;
			userRole = membership.role;
			if (!project.owner_id) return new Response('Project not found', { status: 404 });

			if (userRole === 'owner' || userRole === 'editor') {
				const group = await ensureGroupJournal(admin, env, project.id, project.owner_id);
				await ensureJournalDraft(Astro.locals.supabase, project.id, group.id);
			}

			journals = await loadProjectJournals(admin, env, project.id, user.id);
			for (const journal of journals) {
				if (journal.canEdit && !journal.draft) {
					journal.draft = await ensureJournalDraft(Astro.locals.supabase, project.id, journal.fileId);
				}
			}
			journals.sort((a, b) => {
				if (a.kind !== b.kind) return a.kind === 'group' ? -1 : 1;
				return (a.creatorName ?? a.filename).localeCompare(b.creatorName ?? b.filename);
			});
			const requestedJournalId = Astro.url.searchParams.get('journal');
			initialActiveJournalId = journals.some((journal) => journal.fileId === requestedJournalId)
				? requestedJournalId
				: journals.find((journal) => journal.kind === 'group')?.fileId ?? journals[0]?.fileId ?? null;
			canCreatePersonalJournal = (userRole === 'owner' || userRole === 'editor')
				&& !journals.some((journal) => journal.kind === 'personal' && journal.creatorId === user.id);

			if (userRole === 'owner') {
				const { data: privateRows } = await journalSchemaClient(admin)
					.from('files')
					.select('id, filename, uploaded_by, profiles!files_uploaded_by_fkey(display_name)')
					.eq('project_id', project.id)
					.eq('journal_kind', 'personal')
					.eq('journal_visibility', 'private')
					.neq('uploaded_by', user.id)
					.is('deleted_at', null);
				privateJournalManagement = (privateRows ?? []).map((row: {
					id: string;
					filename: string;
					profiles: { display_name: string } | Array<{ display_name: string }> | null;
				}) => ({
					fileId: row.id,
					filename: row.filename,
					creatorName: (Array.isArray(row.profiles) ? row.profiles[0] : row.profiles)?.display_name ?? 'Former member',
				}));
			}
		}
	}
}

if (!project) {
	const gate = await getPublicProjectGate(admin, id, 'journal');
	if (!gate) return new Response('Project not found', { status: 404 });

	const publicEntries = await loadPublicEntries(gate.id);
	if (!publicEntries) return new Response('Could not load journal', { status: 500 });

	project = { ...gate, description: null, owner_id: null };
	publicNav = true;
	readOnly = true;
	entries = publicEntries;
}
---
<BaseLayout
	title={`${project.name} — Journal`}
	projectNav={{
		projectId: project.id,
		userRole: userRole ?? '',
		publicNav,
		publicSections: toPublicSectionFlags(project),
	}}
>
	{readOnly && <JournalHistory entries={entries} />}
	{!readOnly && initialActiveJournalId && (
		<JournalPage
			client:load
			projectId={project.id}
			currentUserId={user!.id}
			initialJournals={journals}
			initialActiveJournalId={initialActiveJournalId}
			canCreatePersonalJournal={canCreatePersonalJournal}
			initialPrivateJournalManagement={privateJournalManagement}
		/>
	)}
</BaseLayout>
