---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MemberManager from '../../../components/MemberManager.svelte';
import AddMemberForm from '../../../components/AddMemberForm.svelte';
import AddGhostMemberForm from '../../../components/AddGhostMemberForm.svelte';
import GhostMemberManager from '../../../components/GhostMemberManager.svelte';
import DeleteProjectPanel from '../../../components/DeleteProjectPanel.svelte';
import CurrencyPicker from '../../../components/CurrencyPicker.svelte';
import TrashList from '../../../components/TrashList.svelte';
import { listGhostMembers } from '../../../lib/ghost-members';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

const [{ data: project, error }, { data: members }, ghostMembers] = await Promise.all([
	Astro.locals.supabase.from('projects').select('id, name, description, owner_id, currency').eq('id', id).single(),
	Astro.locals.supabase
		.from('project_members')
		.select('role, is_auditor, user_id, profiles(display_name, email, avatar)')
		.eq('project_id', id)
		.overrideTypes<
			{
				role: string;
				is_auditor: boolean;
				user_id: string;
				profiles: { display_name: string; email: string; avatar: string | null };
			}[]
		>(),
	listGhostMembers(Astro.locals.supabase, id!),
]);

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

const userRole = members?.find((member) => member.user_id === user.id)?.role;
const isOwner = userRole === 'owner';

// Settings is entirely owner-only actions (member removal, project deletion) —
// unlike the other project pages, there's nothing here for a non-owner to see.
if (!isOwner) {
	return Astro.redirect(`/projects/${id}`);
}

const memberData = (members ?? []).map((m) => ({
	user_id: m.user_id,
	role: m.role,
	is_auditor: m.is_auditor,
	display_name: m.profiles?.display_name ?? '',
	avatar: m.profiles?.avatar ?? null,
}));

const returnTo = `/projects/${id}/settings`;

interface FileRow {
	id: string;
	filename: string;
	size_bytes: number | null;
	deleted_at: string;
}

interface FolderRow {
	id: string;
	name: string;
	deleted_at: string;
}

interface TaskRow {
	id: string;
	name: string;
	category: string | null;
	deleted_at: string;
}

interface BomItemRow {
	id: string;
	part_name: string;
	category: string | null;
	total_cost: number | null;
	deleted_at: string;
}

interface TransactionRow {
	id: string;
	type: string;
	item_name: string | null;
	transaction_date: string;
	total_cost: number | null;
	deleted_at: string;
}

// Trash lives at the bottom of this page rather than on its own project tab.
const [{ data: files }, { data: folders }, { data: tasks }, { data: bomItems }, { data: transactions }] = await Promise.all([
	Astro.locals.supabase
		.from('files')
		.select('id, filename, size_bytes, deleted_at')
		.eq('project_id', id)
		.not('deleted_at', 'is', null)
		.order('deleted_at', { ascending: false })
		.overrideTypes<FileRow[]>(),
	Astro.locals.supabase
		.from('folders')
		.select('id, name, deleted_at')
		.eq('project_id', id)
		.not('deleted_at', 'is', null)
		.order('deleted_at', { ascending: false })
		.overrideTypes<FolderRow[]>(),
	Astro.locals.supabase
		.from('tasks')
		.select('id, name, category, deleted_at')
		.eq('project_id', id)
		.not('deleted_at', 'is', null)
		.order('deleted_at', { ascending: false })
		.overrideTypes<TaskRow[]>(),
	Astro.locals.supabase
		.from('bom_items')
		.select('id, part_name, category, total_cost, deleted_at')
		.eq('project_id', id)
		.not('deleted_at', 'is', null)
		.order('deleted_at', { ascending: false })
		.overrideTypes<BomItemRow[]>(),
	// Lines of a trashed bulk transaction (group_id set) are restored/purged
	// together with their parent, not listed as their own row.
	Astro.locals.supabase
		.from('transactions')
		.select('id, type, item_name, transaction_date, total_cost, deleted_at')
		.eq('project_id', id)
		.is('group_id', null)
		.not('deleted_at', 'is', null)
		.order('deleted_at', { ascending: false })
		.overrideTypes<TransactionRow[]>(),
]);
---
<BaseLayout title={`${project.name} — Settings`} projectNav={{ projectId: project.id, userRole: userRole ?? '' }}>
	<section>
		<h3>Currency</h3>
		<CurrencyPicker client:load projectId={project.id} currency={project.currency} />
	</section>

	<section>
		<h3>Members</h3>
		<MemberManager client:load projectId={project.id} members={memberData} />
		<GhostMemberManager client:load projectId={project.id} ghostMembers={ghostMembers} />
		<div class="add-actions-row">
			<AddMemberForm client:load projectId={project.id} returnTo={returnTo} />
			<AddGhostMemberForm client:load projectId={project.id} />
		</div>
	</section>

	<section>
		<h3>Danger zone</h3>
		<DeleteProjectPanel client:load projectId={project.id} projectName={project.name} />
	</section>

	<section>
		<h3>Trash</h3>
		<p class="muted trash-note">Deleted items are kept here for 10 days before they're removed for good.</p>
		<TrashList
			client:load
			projectId={project.id}
			currency={project.currency}
			canEditMoney={true}
			initialFiles={files ?? []}
			initialFolders={folders ?? []}
			initialTasks={tasks ?? []}
			initialBomItems={bomItems ?? []}
			initialTransactions={transactions ?? []}
		/>
	</section>
</BaseLayout>

<style>
	section {
		margin-top: var(--space-6);
	}

	section:first-child {
		margin-top: 0;
	}

	section h3 {
		margin-bottom: var(--space-3);
	}

	.trash-note {
		font-size: 0.85rem;
	}

	.add-actions-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	.add-actions-row > :global(*) {
		flex: 1 1 240px;
		margin: 0;
	}
</style>
