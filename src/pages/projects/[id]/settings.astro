---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MemberManager from '../../../components/MemberManager.svelte';
import AddMemberForm from '../../../components/AddMemberForm.svelte';
import AddGhostMemberForm from '../../../components/AddGhostMemberForm.svelte';
import GhostMemberManager from '../../../components/GhostMemberManager.svelte';
import DeleteProjectPanel from '../../../components/DeleteProjectPanel.svelte';
import ProjectNameEditor from '../../../components/ProjectNameEditor.svelte';
import CurrencyPicker from '../../../components/CurrencyPicker.svelte';
import TrashList from '../../../components/TrashList.svelte';
import ProjectVisibilityPicker from '../../../components/ProjectVisibilityPicker.svelte';
import DownloadProjectButton from '../../../components/DownloadProjectButton.svelte';
import PicturePicker from '../../../components/PicturePicker.svelte';
import TransferOwnershipPanel from '../../../components/TransferOwnershipPanel.svelte';
import type { CurrencyCode } from '../../../lib/currency.svelte';
import { listGhostMembers } from '../../../lib/ghost-members';
import { normalizeAvatar, normalizeProjectAvatar } from '../../../lib/avatars';
import { toPublicSectionFlags } from '../../../lib/project-visibility';

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
	return Astro.redirect('/login');
}

const { id } = Astro.params;

const [{ data: project, error }, { data: members }, ghostMembers] = await Promise.all([
	Astro.locals.supabase
		.from('projects')
		.select('id, name, description, owner_id, avatar, currency, is_public, public_files_enabled, public_tasks_enabled, public_journal_enabled, public_money_enabled')
		.eq('id', id)
		.single()
		.overrideTypes<{
			id: string;
			name: string;
			description: string | null;
			owner_id: string;
			avatar: string | null;
			currency: CurrencyCode;
			is_public: boolean;
			public_files_enabled: boolean;
			public_tasks_enabled: boolean;
			public_journal_enabled: boolean;
			public_money_enabled: boolean;
		}>(),
	Astro.locals.supabase
		.from('project_members')
		.select('role, is_auditor, user_id, profiles(display_name, email, avatar)')
		.eq('project_id', id)
		.overrideTypes<
			{
				role: string;
				is_auditor: boolean;
				user_id: string;
				profiles: { display_name: string; email: string; avatar: string | null };
			}[]
		>(),
	listGhostMembers(Astro.locals.supabase, id!),
]);

if (error || !project) {
	return new Response('Project not found', { status: 404 });
}

const userRole = members?.find((member) => member.user_id === user.id)?.role;
const isOwner = userRole === 'owner';

// Settings is entirely owner-only actions (member removal, project deletion) —
// unlike the other project pages, there's nothing here for a non-owner to see.
if (!isOwner) {
	return Astro.redirect(`/projects/${id}`);
}

const memberData = (members ?? []).map((m) => ({
	user_id: m.user_id,
	role: m.role,
	is_auditor: m.is_auditor,
	display_name: m.profiles?.display_name ?? '',
	avatar: m.profiles?.avatar ?? null,
}));

const owner = members?.find((member) => member.user_id === project.owner_id)?.profiles;
const ownerDisplayName = owner?.display_name ?? project.name;
const ownerAvatar = normalizeAvatar(owner?.avatar);
const projectAvatar = normalizeProjectAvatar(project.avatar);

const returnTo = `/projects/${id}/settings`;

---
<BaseLayout
	title={`${project.name} — Settings`}
	projectNav={{
		projectId: project.id,
		userRole: userRole ?? '',
		publicNav: false,
		publicSections: toPublicSectionFlags(project),
	}}
>
	<section>
		<h3>Project picture</h3>
		<PicturePicker
			client:idle
			initialAvatar={projectAvatar}
			displayName={project.name}
			fallbackAvatar={ownerAvatar}
			fallbackDisplayName={ownerDisplayName}
			endpoint={`/api/projects/${project.id}/update-picture`}
			defaultLabel="Default"
			defaultAriaLabel="Use the owner's picture"
			selectedNote="Shown next to this project in navigation."
			defaultNote="Uses the owner's current profile picture."
			pictureLabel="project picture"
		/>
	</section>

	<section>
		<h3>Project name</h3>
		<ProjectNameEditor client:idle projectId={project.id} initialName={project.name} />
	</section>

	<section>
		<h3>Currency</h3>
		<CurrencyPicker client:idle projectId={project.id} currency={project.currency} />
	</section>

	<section>
		<h3>Visibility</h3>
		<ProjectVisibilityPicker
			client:idle
			projectId={project.id}
			isPublic={project.is_public}
			publicFilesEnabled={project.public_files_enabled}
			publicTasksEnabled={project.public_tasks_enabled}
			publicJournalEnabled={project.public_journal_enabled}
			publicMoneyEnabled={project.public_money_enabled}
		/>
	</section>

	<section>
		<h3>Members</h3>
		<MemberManager client:idle projectId={project.id} members={memberData} />
		<GhostMemberManager client:idle projectId={project.id} ghostMembers={ghostMembers} />
		<div class="add-actions-row">
			<AddMemberForm client:idle projectId={project.id} returnTo={returnTo} />
			<AddGhostMemberForm client:idle projectId={project.id} />
		</div>
	</section>

	<section>
		<h3>Download project</h3>
		<DownloadProjectButton client:idle projectId={project.id} />
	</section>

	<section>
		<h3>Danger zone</h3>
		<TransferOwnershipPanel
			client:idle
			projectId={project.id}
			projectName={project.name}
			members={memberData
				.filter((member) => member.user_id !== project.owner_id)
				.map((member) => ({ user_id: member.user_id, display_name: member.display_name }))}
		/>
		<DeleteProjectPanel client:idle projectId={project.id} projectName={project.name} />
	</section>

	<section>
		<h3>Trash</h3>
		<p class="muted trash-note">Deleted items are kept here for 10 days before they're removed for good.</p>
		<TrashList
			client:visible
			projectId={project.id}
			currency={project.currency}
			canEditMoney={true}
		/>
	</section>
</BaseLayout>

<style>
	section {
		margin-top: var(--space-6);
	}

	section:first-child {
		margin-top: 0;
	}

	section h3 {
		margin-bottom: var(--space-3);
	}

	.trash-note {
		font-size: 0.85rem;
	}

	.add-actions-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	.add-actions-row > :global(*) {
		flex: 1 1 240px;
		margin: 0;
	}

	section :global(.transfer-panel + .delete-panel) {
		margin-top: var(--space-4);
	}
</style>
