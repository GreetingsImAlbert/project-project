---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const user = Astro.locals.user;
const isGuest = !user;

// Members list every project they're part of through RLS. Guests get the
// public slice instead: same list UI, but only `is_public` projects and only
// the id/name/description columns the boundary RPC exposes. There is
// deliberately no anonymous SELECT policy on projects (see SCHEMA.md) — the
// `public_project_list` RPC is the only anonymous read path, so a guest cannot
// name a field beyond those three.
let projects: { id: string; name: string; description: string | null }[] | null = null;
let errorMessage: string | null = null;

if (isGuest) {
	const { data, error } = await Astro.locals.supabase.rpc('public_project_list');
	projects = data;
	errorMessage = error?.message ?? null;
} else {
	const { data, error } = await Astro.locals.supabase
		.from('projects')
		.select('id, name, description, created_at')
		.order('created_at', { ascending: false });
	projects = data;
	errorMessage = error?.message ?? null;
}
---
<BaseLayout title="Projects">
	<h1>Projects</h1>
	{user && <p><a href="/projects/new" data-astro-prefetch>+ New project</a></p>}

	{errorMessage && <p class="muted">Error loading projects: {errorMessage}</p>}

	{projects && projects.length === 0 && <p class="muted">No projects yet.</p>}

	<ul class="list-plain">
		{projects?.map((project) => (
			<li>
				<a href={`/projects/${project.id}`} data-astro-prefetch>{project.name}</a>
				{project.description && <p class="muted">{project.description}</p>}
			</li>
		))}
	</ul>
</BaseLayout>
