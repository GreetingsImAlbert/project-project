---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublicSection, publicProjectPath } from '../../lib/project-visibility';

export const prerender = false;

const user = Astro.locals.user;
const isGuest = !user;

// Members list every project they're part of through RLS, plus discoverable
// projects they're not a member of. The public RPC supplies the safe landing
// section so Overview-private projects do not get a dead Overview link.
type PublicProjectListRow = {
	id: string;
	name: string;
	description: string | null;
	landing_page: string;
};

type ProjectListItem = {
	id: string;
	name: string;
	description: string | null;
	href: string;
};

function publicProjectItem(project: PublicProjectListRow): ProjectListItem | null {
	return isPublicSection(project.landing_page)
		? { ...project, href: publicProjectPath(project.id, project.landing_page) }
		: null;
}

let projects: ProjectListItem[] | null = null;
let errorMessage: string | null = null;

if (isGuest) {
	const { data, error } = await Astro.locals.supabase.rpc('public_project_list');
	const publicRows = (data ?? []) as unknown as PublicProjectListRow[];
	projects = publicRows.flatMap((project) => {
		const item = publicProjectItem(project);
		return item ? [item] : [];
	});
	errorMessage = error?.message ?? null;
} else {
	const [
		{ data: memberRows, error: memberError },
		{ data: publicRowsRaw, error: publicError },
	] = await Promise.all([
		Astro.locals.supabase
			.from('projects')
			.select('id, name, description, created_at')
			.order('created_at', { ascending: false }),
		Astro.locals.supabase.rpc('public_project_list'),
	]);

	if (memberError || publicError) {
		errorMessage = memberError?.message ?? publicError?.message ?? null;
	} else {
		const publicRows = (publicRowsRaw ?? []) as unknown as PublicProjectListRow[];
		const memberIds = new Set((memberRows ?? []).map((project) => project.id));
		const publicOnly = (publicRows ?? []).flatMap((project) => {
			if (memberIds.has(project.id)) return [];
			const item = publicProjectItem(project);
			return item ? [item] : [];
		});
		projects = [
			...(memberRows ?? []).map((project) => ({
				id: project.id,
				name: project.name,
				description: project.description,
				href: `/projects/${project.id}`,
			})),
			...publicOnly,
		];
	}
}
---
<BaseLayout title="Projects">
	<h1>Projects</h1>
	{user && <p><a href="/projects/new" data-astro-prefetch>+ New project</a></p>}

	{errorMessage && <p class="muted">Error loading projects: {errorMessage}</p>}

	{projects && projects.length === 0 && <p class="muted">No projects yet.</p>}

	<ul class="list-plain">
		{projects?.map((project) => (
			<li>
				<a href={project.href} data-astro-prefetch>{project.name}</a>
				{project.description && <p class="muted">{project.description}</p>}
			</li>
		))}
	</ul>
</BaseLayout>
