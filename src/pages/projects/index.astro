---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

if (!Astro.locals.user) {
	return Astro.redirect('/login');
}

const { data: projects, error } = await Astro.locals.supabase
	.from('projects')
	.select('id, name, description, created_at')
	.order('created_at', { ascending: false });
---
<BaseLayout title="My Projects">
	<h1>My Projects</h1>
	<p><a href="/projects/new">+ New project</a></p>

	{error && <p class="muted">Error loading projects: {error.message}</p>}

	{projects && projects.length === 0 && <p class="muted">No projects yet.</p>}

	<ul class="list-plain">
		{projects?.map((project) => (
			<li>
				<a href={`/projects/${project.id}`}>{project.name}</a>
				{project.description && <p class="muted">{project.description}</p>}
			</li>
		))}
	</ul>
</BaseLayout>