---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImportProjectForm from '../../components/ImportProjectForm.svelte';

export const prerender = false;

if (!Astro.locals.user) {
	return Astro.redirect('/login');
}
---
<BaseLayout title="New Project">
	<p><a href="/projects">← Back to projects</a></p>

	<h1>Create a project</h1>
	<form method="POST" action="/api/projects/create" onsubmit="this.querySelector('button').disabled = true" class="new-project-form">
		<input type="text" name="name" placeholder="Project name" required />
		<textarea name="description" placeholder="Description (optional)"></textarea>
		<button type="submit">Create</button>
	</form>

	<section class="import-project-section">
		<h2>Import project</h2>
		<p class="muted">Restore a project from a ZIP downloaded from P2. The archive’s project name is used automatically.</p>
		<ImportProjectForm client:load />
	</section>
</BaseLayout>

<style>
	.new-project-form {
		flex-direction: column;
		align-items: stretch;
		max-width: 420px;
	}

	.import-project-section {
		max-width: 560px;
		margin-top: var(--space-7);
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.import-project-section h2 {
		margin-top: 0;
	}

	.import-project-section p {
		margin-bottom: var(--space-3);
	}
</style>
