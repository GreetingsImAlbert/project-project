---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSupabaseAdmin } from '../../lib/supabase/admin';
import { isAdminUser } from '../../lib/admin-guard';
import { getGlobalStorageBreakdown } from '../../lib/r2-quota';
import { formatBytes } from '../../lib/format-bytes';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
	return Astro.redirect('/login');
}

if (!(await isAdminUser(Astro.locals.supabase, user.id))) {
	return Astro.redirect('/');
}

const admin = getSupabaseAdmin(env);

// Two plain selects folded in JS, not an embedded `profiles(...)` select — PostgREST
// resolves that embed through its schema-cache relationship graph, which silently
// returned zero rows here (data: null, error swallowed) rather than erroring loudly.
const [{ data: projects, error: projectsError }, { data: members }, { byProject, failed }] = await Promise.all([
	admin
		.from('projects')
		.select('id, name, created_at, owner_id')
		.order('created_at', { ascending: false }),
	admin.from('project_members').select('project_id'),
	getGlobalStorageBreakdown(admin),
]);

if (projectsError) {
	console.log(`[admin/projects] failed to load projects: ${projectsError.message}`);
}

const ownerIds = [...new Set((projects ?? []).map((project) => project.owner_id))];
const { data: owners } = ownerIds.length
	? await admin.from('profiles').select('id, display_name, email').in('id', ownerIds)
	: { data: [] };

const ownerById: Record<string, { display_name: string; email: string | null }> = {};
for (const owner of owners ?? []) {
	ownerById[owner.id] = owner;
}

const memberCounts: Record<string, number> = {};
for (const row of members ?? []) {
	memberCounts[row.project_id] = (memberCounts[row.project_id] ?? 0) + 1;
}
---

<BaseLayout title="Admin · Projects">
	<h1>All Projects</h1>
	<p><a href="/admin">← Admin Dashboard</a></p>

	{failed && (
		<p class="storage-error">
			Storage totals below are unavailable (the usage read failed).
			<a class="reload-link" href={Astro.url.pathname}>⟳ Reload</a>
		</p>
	)}

	{projectsError && (
		<p class="storage-error">
			Failed to load projects.
			<a class="reload-link" href={Astro.url.pathname}>⟳ Reload</a>
		</p>
	)}

	{projects && projects.length === 0 && <p class="muted">No projects yet.</p>}

	<div class="table-scroll">
		<table>
			<thead>
				<tr>
					<th>Project</th>
					<th>Owner</th>
					<th>Members</th>
					<th>Storage used</th>
					<th>Created</th>
				</tr>
			</thead>
			<tbody>
				{projects?.map((project) => (
					<tr>
						<td>{project.name}</td>
						<td>{ownerById[project.owner_id]?.display_name ?? '—'} <span class="muted">({ownerById[project.owner_id]?.email ?? 'unknown'})</span></td>
						<td>{memberCounts[project.id] ?? 0}</td>
						<td>{failed ? '—' : formatBytes(byProject[project.id] ?? 0)}</td>
						<td>{project.created_at ? new Date(project.created_at).toLocaleDateString() : '—'}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
</BaseLayout>

<style>
	.storage-error {
		color: var(--color-danger);
	}

	.reload-link {
		margin-left: var(--space-1);
	}
</style>
