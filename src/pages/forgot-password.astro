---
import BaseLayout from '../layouts/BaseLayout.astro';
import ForgotPasswordForm from '../components/ForgotPasswordForm.svelte';

export const prerender = false;

// Deliberately outside middleware's APP_PATH_PREFIXES, like /reset-password: this page
// has nothing to say to a session and shouldn't cost a Supabase round trip to render.

const sent = Astro.url.searchParams.get('sent') === '1';
---

<BaseLayout title="Forgot password">
	<div class="auth-page">
		<h1>Reset your password</h1>
		<p class="muted">
			Enter the email you signed up with and we'll send a link for setting a new password.
		</p>
		<ForgotPasswordForm client:load sent={sent} />
		<p><a href="/login">← Back to log in</a></p>
	</div>
</BaseLayout>

<style>
	.auth-page {
		max-width: 420px;
		margin: 0 auto;
	}

	.auth-page form {
		flex-direction: column;
		align-items: stretch;
	}
</style>
