---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

// Deliberately outside middleware's APP_PATH_PREFIXES, like /reset-password: this page
// has nothing to say to a session and shouldn't cost a Supabase round trip to render.

const sent = Astro.url.searchParams.get('sent') === '1';
---

<BaseLayout title="Forgot password">
	<div class="auth-page">
		<h1>Reset your password</h1>

		{sent ? (
			<Fragment>
				<p role="status">
					If an account exists for that address, a reset link is on its way. It is single-use and
					expires shortly — open the newest one if you asked more than once.
				</p>
				<p><a href="/login">← Back to log in</a></p>
			</Fragment>
		) : (
			<Fragment>
				<p class="muted">
					Enter the email you signed up with and we'll send a link for setting a new password.
				</p>
				<!-- data-astro-reload for the same reason as the login form: this posts to an
				     endpoint that redirects, and the ClientRouter would otherwise swap in the
				     response without the URL following it. -->
				<form
					method="POST"
					action="/api/auth/forgot-password"
					data-astro-reload
					onsubmit="this.querySelector('button').disabled = true"
				>
					<input type="email" name="email" placeholder="Email" autocomplete="email" required />
					<button type="submit">Send reset link</button>
				</form>
				<p><a href="/login">← Back to log in</a></p>
			</Fragment>
		)}
	</div>
</BaseLayout>

<style>
	.auth-page {
		max-width: 420px;
		margin: 0 auto;
	}

	.auth-page form {
		flex-direction: column;
		align-items: stretch;
	}
</style>
