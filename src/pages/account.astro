---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import StorageUsageBar from '../components/StorageUsageBar.astro';
import AccountDisplayNameForm from '../components/AccountDisplayNameForm.svelte';
import AccountAvatarPicker from '../components/AccountAvatarPicker.svelte';
import AccountPasswordForm from '../components/AccountPasswordForm.svelte';
import DeleteAccountPanel from '../components/DeleteAccountPanel.svelte';
import { getSupabaseAdmin } from '../lib/supabase/admin';
import { getStorageUsage } from '../lib/r2-quota';
import { normalizeAvatar } from '../lib/avatars';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
	return Astro.redirect('/login');
}

const [{ data: profile }, { count: projectCount }, { count: ownedProjectCount }] = await Promise.all([
	// RLS scopes this to the caller's own row, so the session client is the right one.
	Astro.locals.supabase.from('profiles').select('display_name, email, created_at, avatar').eq('id', user.id).single(),
	Astro.locals.supabase.from('project_members').select('project_id', { count: 'exact', head: true }).eq('user_id', user.id),
	Astro.locals.supabase.from('projects').select('id', { count: 'exact', head: true }).eq('owner_id', user.id),
]);

const admin = getSupabaseAdmin(env);
const { totalBytes, maxBytes, scope, failed } = await getStorageUsage(admin, env, user.id);

// The JWT is the fallback rather than the source: profiles is what other members read,
// including the custom avatar's Supabase Storage path.
const displayName = profile?.display_name ?? user.displayName ?? '';
const email = profile?.email ?? user.email ?? '—';
const createdAt = profile?.created_at ? new Date(profile.created_at).toLocaleDateString() : '—';
// profiles is the source here too, for the same reason as the name — the JWT copy is
// only what the navbar reads.
const avatar = normalizeAvatar(profile?.avatar ?? user.avatar);
---

<BaseLayout title="Account">
	<h1>Account</h1>

	<h2>Profile picture</h2>
	<AccountAvatarPicker client:load initialAvatar={avatar} displayName={displayName} />

	<h2>Details</h2>
	<!-- A plain grid rather than a <dl>: the display-name field is a Svelte island, and
	     Astro renders one as an <astro-island> wrapper, which a <dl> can't legally hold. -->
	<div class="account-details">
		<AccountDisplayNameForm client:load initialDisplayName={displayName} />
		<div class="account-detail">
			<span class="detail-label">Email</span>
			<span class="detail-value">{email}</span>
		</div>
		<div class="account-detail">
			<span class="detail-label">Member since</span>
			<span class="detail-value">{createdAt}</span>
		</div>
		<div class="account-detail">
			<span class="detail-label">Projects</span>
			<span class="detail-value">{projectCount ?? 0}</span>
		</div>
	</div>

	<h2>Storage</h2>
	<StorageUsageBar usedBytes={totalBytes} capBytes={maxBytes} scope={scope} failed={failed} />

	<h2>Change password</h2>
	<AccountPasswordForm client:visible />
	<p class="muted account-forgot">
		Don't remember your current password? <a href="/forgot-password">Reset it by email →</a>
	</p>

	<h2>Danger zone</h2>
	<DeleteAccountPanel client:visible ownedProjectCount={ownedProjectCount ?? 0} displayName={displayName} />
</BaseLayout>

<style>
	/* No divider straight under the page title — the Dashboard and Project pages
	   don't draw one either. */
	h2:first-of-type {
		margin-top: 0;
		padding-top: 0;
		border-top: none;
	}

	.account-forgot {
		font-size: 0.85rem;
	}
</style>
