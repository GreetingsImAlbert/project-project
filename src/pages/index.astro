---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import StorageUsageBar from '../components/StorageUsageBar.astro';
import { getSupabaseAdmin } from '../lib/supabase/admin';
import { getUserStorageBytes, MAX_USER_STORAGE_BYTES } from '../lib/r2-quota';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
	return Astro.redirect('/login');
}

const { data: profile } = await Astro.locals.supabase
	.from('profiles')
	.select('display_name')
	.eq('id', user.id)
	.single();

const displayName = profile?.display_name;

const admin = getSupabaseAdmin(env);
const { totalBytes, truncated } = await getUserStorageBytes(admin, user.id);
---
<BaseLayout title="Dashboard">
	<h1>Dashboard</h1>
	<p class="muted">Welcome, {displayName ?? user.email}</p>
	<p><a href="/projects">Go to Projects →</a></p>
	<StorageUsageBar usedBytes={totalBytes} capBytes={MAX_USER_STORAGE_BYTES} failed={truncated} />
</BaseLayout>