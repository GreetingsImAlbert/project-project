---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForms from '../components/AuthForms.svelte';

export const prerender = false;

if (Astro.locals.user) {
	return Astro.redirect('/');
}

const checkEmail = Astro.url.searchParams.get('checkEmail') === '1';
---

<BaseLayout title="Login">
	<div class="auth-page">
		<h1>Welcome to P2</h1>
		<AuthForms client:load checkEmail={checkEmail} />
	</div>
</BaseLayout>

<style>
	.auth-page {
		max-width: 420px;
		margin: 0 auto;
	}
</style>
