---
import BaseLayout from "../layouts/BaseLayout.astro";
export const prerender = false;

if (Astro.locals.user) {
	return Astro.redirect('/');
}

const checkEmail = Astro.url.searchParams.get('checkEmail') === '1';
---

<BaseLayout title="Login">
	<div class="auth-page">
		<h1>Welcome to P2</h1>
		{checkEmail && (
			<p role="status" class="muted">Account created! Check your email for a confirmation link before logging in.</p>
		)}

		<h2>Log in</h2>
		<!-- data-astro-reload on both: same reason as the logout form in Header.astro —
		     signing in changes identity, so it has to be a full document load. -->
		<form method="POST" action="/api/auth/login" data-astro-reload onsubmit="this.querySelector('button').disabled = true">
			<input type="email" name="email" placeholder="Email" required />
			<input type="password" name="password" placeholder="Password" required />
			<button type="submit">Log in</button>
		</form>
		<p class="auth-aside muted"><a href="/forgot-password">Forgot your password?</a></p>

		<h2>Sign up</h2>
		<form method="POST" action="/api/auth/signup" data-astro-reload onsubmit="this.querySelector('button').disabled = true">
			<input type="email" name="email" placeholder="Email" required />
			<input type="password" name="password" placeholder="Password" required />
			<input type="text" name="displayName" placeholder="Display name" required />
			<button type="submit">Sign up</button>
		</form>
	</div>
</BaseLayout>

<style>
	.auth-page {
		max-width: 420px;
		margin: 0 auto;
	}

	.auth-page form {
		flex-direction: column;
		align-items: stretch;
	}

	.auth-aside {
		font-size: 0.85rem;
	}
</style>