---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

if (!Astro.locals.user) {
	return Astro.redirect('/login');
}

import { env } from 'cloudflare:workers';
const { data, error } = await Astro.locals.supabase.from('profiles').select('*');
const r2Objects = await env.R2_BUCKET.list();
---
<BaseLayout title="Dashboard | P2">
    <h1>Dashboard</h1>
    <p>Welcome, {Astro.locals.user.email}</p>

    <p>Supabase says: {error ? `Error: ${error.message}` : `${data.length} rows in profiles`}</p>
    <p>R2 bucket has {r2Objects.objects.length} objects</p>
    
    <form method="POST" action="/api/auth/logout">
        <button type="submit">Log out</button>
    </form>
</BaseLayout>