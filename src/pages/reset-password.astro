---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResetPasswordForm from '../components/ResetPasswordForm.svelte';

export const prerender = false;

// No auth work happens here, and that is the point. This route is deliberately left out
// of middleware's APP_PATH_PREFIXES so no Supabase client is built and no cookie is read
// or written while rendering it: arriving from a recovery email must not sign anyone in.
//
// It can afford that because the recovery tokens arrive in the URL *fragment*, which
// browsers never send to the server (see supabase/stateless.ts for why the flow is set
// up that way). ResetPasswordForm reads them client-side and posts them to
// /api/auth/reset-password only when a new password is submitted; that endpoint sets the
// password and revokes every session, without ever minting a cookie for this browser.
---

<BaseLayout title="Set a new password">
	<div class="auth-page">
		<h1>Set a new password</h1>
		<ResetPasswordForm client:load />
	</div>
</BaseLayout>

<style>
	.auth-page {
		max-width: 420px;
		margin: 0 auto;
	}
</style>
