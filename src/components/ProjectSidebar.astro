---
interface Member {
	role: string;
	is_auditor: boolean;
	user_id: string;
	profiles: { display_name: string; email: string };
}

interface GhostMember {
	id: string;
	display_name: string;
}

interface Props {
	project: { id: string; name: string; description: string | null };
	members: Member[];
	ghostMembers: GhostMember[];
	userRole: string | undefined;
	activePage: 'overview' | 'tasks' | 'files' | 'journal' | 'money' | 'settings';
}

const { project, members, ghostMembers, userRole, activePage } = Astro.props;
const isOwner = userRole === 'owner';
// Journal follows base editor rights, same as Files/Tasks — a viewer has nothing
// to do there (see journal.astro, which redirects one away outright).
const canUseJournal = userRole === 'owner' || userRole === 'editor';

// Members are grouped by role instead of colour-coded — owner first, then
// editors, then viewers. Any role the check constraint grows later still shows
// up (under its own raw name) rather than silently disappearing.
const ROLE_ORDER = ['owner', 'editor', 'viewer'];
const ROLE_LABELS: Record<string, string> = { owner: 'Owner', editor: 'Editors', viewer: 'Viewers' };

const roles = [...new Set(members.map((m) => m.role))].sort((a, b) => {
	const ai = ROLE_ORDER.indexOf(a);
	const bi = ROLE_ORDER.indexOf(b);
	return (ai === -1 ? ROLE_ORDER.length : ai) - (bi === -1 ? ROLE_ORDER.length : bi);
});

const memberGroups = roles.map((role) => ({
	role,
	label: ROLE_LABELS[role] ?? role,
	members: members.filter((m) => m.role === role),
}));
---

<aside class="project-sidebar">
	<p class="sidebar-title">{project.name}</p>

	<p class="sidebar-label">Members:</p>

	<div class="member-groups">
		{memberGroups.map((group) => (
			<div class="member-group">
				<p class="group-label">{group.label}</p>
				<ul class="member-list">
					{group.members.map((m) => (
						<li class="member-row">
							{m.profiles?.display_name}{m.is_auditor && (<span class="capability"> [auditor]</span>)}
						</li>
					))}
				</ul>
			</div>
		))}
	</div>

	{ghostMembers.length > 0 && (
		<div class="member-group">
			<p class="group-label">Ghosts</p>
			<ul class="member-list">
				{ghostMembers.map((g) => (
					<li class="member-row">
						{g.display_name}
					</li>
				))}
			</ul>
		</div>
	)}

	<nav class="sidebar-nav">
		<a href={`/projects/${project.id}`} class={activePage === 'overview' ? 'active' : ''}>Overview</a>
		<a href={`/projects/${project.id}/tasks`} class={activePage === 'tasks' ? 'active' : ''}>Tasks</a>
		<a href={`/projects/${project.id}/files`} class={activePage === 'files' ? 'active' : ''}>Files</a>
		{canUseJournal && (
			<a href={`/projects/${project.id}/journal`} class={activePage === 'journal' ? 'active' : ''}>Journal</a>
		)}
		<a href={`/projects/${project.id}/money`} class={activePage === 'money' ? 'active' : ''}>Money</a>
		{isOwner && (
			<a href={`/projects/${project.id}/settings`} class={activePage === 'settings' ? 'active' : ''}>Settings</a>
		)}
	</nav>
</aside>

<style>
	.project-sidebar {
		flex: 0 0 240px;
		min-width: 0;
		position: sticky;
		top: var(--space-5);
		font-size: 0.85rem;
		align-self: flex-start;
	}

	.sidebar-title {
		font-weight: 700;
		font-size: 1rem;
		margin: 0 0 var(--space-2);
	}

	.sidebar-label {
		font-weight: 700;
		margin: 0 0 var(--space-2);
	}

	.member-groups {
		margin: 0 0 var(--space-3);
	}

	.member-group + .member-group {
		margin-top: var(--space-3);
	}

	.group-label {
		margin: 0 0 var(--space-1);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
	}

	.member-list {
		list-style: none;
		margin: 0;
		padding: 0;
		min-width: 0;
	}

	.member-row {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		margin-bottom: var(--space-1);
	}

	.capability {
		color: var(--color-muted);
	}

	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-7);
	}

	.sidebar-nav a {
		border-bottom: 1px solid transparent;
	}

	.sidebar-nav a.active {
		border-bottom-color: currentColor;
	}

	@media (max-width: 768px) {
		.project-sidebar {
			position: static;
			flex-basis: auto;
			width: 100%;
		}
	}
</style>
