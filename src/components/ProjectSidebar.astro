---
import MemberManager from './MemberManager.svelte';

interface Member {
	role: string;
	is_auditor: boolean;
	user_id: string;
	profiles: { display_name: string; email: string };
}

interface Props {
	project: { id: string; name: string; description: string | null };
	members: Member[];
	userRole: string | undefined;
	activePage: 'overview' | 'files' | 'money';
}

const { project, members, userRole, activePage } = Astro.props;
const isOwner = userRole === 'owner';

// Flat, serializable shape for the owner's editing island.
const memberData = members.map((m) => ({
	user_id: m.user_id,
	role: m.role,
	is_auditor: m.is_auditor,
	display_name: m.profiles?.display_name ?? '',
}));

// Bounce the add-member POST back to whichever project page it was submitted
// from; safeReturnTo() in the endpoint re-checks it's an in-app /projects/ path.
const returnTo = Astro.url.pathname;
---

<aside class="project-sidebar">
	<p class="sidebar-title">{project.name}</p>

	<p class="sidebar-label">Members:</p>

	{isOwner ? (
		<MemberManager client:load projectId={project.id} members={memberData} />
	) : (
		<ul class="member-list">
			{members.map((m) => (
				<li class={`member-row role-${m.role}`}>
					{m.profiles?.display_name} ({m.role}){m.is_auditor && (<span class="auditor-badge"> · auditor</span>)}
				</li>
			))}
		</ul>
	)}

	{isOwner && (
		<form method="POST" action={`/api/projects/${project.id}/members`} class="add-member" onsubmit="this.querySelector('button').disabled = true">
			<input type="hidden" name="returnTo" value={returnTo} />
			<input type="email" name="email" placeholder="User's email" required />
			<select name="role">
				<option value="editor">Editor</option>
				<option value="viewer">Viewer</option>
			</select>
			<label class="auditor-toggle">
				<input type="checkbox" name="isAuditor" />
				Auditor (can edit Money)
			</label>
			<button type="submit">Add member</button>
		</form>
	)}

	<nav class="sidebar-nav">
		<a href={`/projects/${project.id}`} class={activePage === 'overview' ? 'active' : ''}>Overview</a>
		<a href={`/projects/${project.id}/files`} class={activePage === 'files' ? 'active' : ''}>Files</a>
		<a href={`/projects/${project.id}/money`} class={activePage === 'money' ? 'active' : ''}>Money</a>
	</nav>
</aside>

<style>
	.project-sidebar {
		flex: 0 0 240px;
		min-width: 0;
		position: sticky;
		top: var(--space-5);
		font-size: 0.85rem;
		align-self: flex-start;
	}

	.sidebar-title {
		font-weight: 700;
		font-size: 1rem;
		margin: 0 0 var(--space-2);
	}

	.sidebar-label {
		font-weight: 700;
		margin: 0 0 var(--space-2);
	}

	.member-list {
		list-style: none;
		margin: 0 0 var(--space-3);
		padding: 0;
		min-width: 0;
	}

	.member-row {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		margin-bottom: var(--space-1);
	}

	.member-row.role-owner {
		color: var(--color-role-owner);
	}

	.member-row.role-editor {
		color: var(--color-role-editor);
	}

	.member-row.role-viewer {
		color: var(--color-role-viewer);
	}

	.auditor-badge {
		color: var(--color-role-auditor);
	}

	.auditor-toggle {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		color: var(--color-role-auditor);
		font-size: 0.8rem;
	}

	.auditor-toggle input {
		width: auto;
		flex: 0 0 auto;
	}

	.add-member {
		flex-direction: column;
		align-items: stretch;
		gap: var(--space-2);
		margin: var(--space-3) 0 var(--space-4);
	}

	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-7);
	}

	.sidebar-nav a {
		border-bottom: 1px solid transparent;
	}

	.sidebar-nav a.active {
		border-bottom-color: currentColor;
	}

	@media (max-width: 768px) {
		.project-sidebar {
			position: static;
			flex-basis: auto;
			width: 100%;
		}
	}
</style>
