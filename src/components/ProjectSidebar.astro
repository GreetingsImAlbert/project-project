---
import MemberManager from './MemberManager.svelte';

interface Member {
	role: string;
	is_auditor: boolean;
	user_id: string;
	profiles: { display_name: string; email: string };
}

interface Props {
	project: { id: string; name: string; description: string | null };
	members: Member[];
	userRole: string | undefined;
	activePage: 'overview' | 'files' | 'money';
}

const { project, members, userRole, activePage } = Astro.props;
const isOwner = userRole === 'owner';

// Flat, serializable shape for the owner's editing island.
const memberData = members.map((m) => ({
	user_id: m.user_id,
	role: m.role,
	is_auditor: m.is_auditor,
	display_name: m.profiles?.display_name ?? '',
}));

// Members are grouped by role instead of colour-coded — owner first, then
// editors, then viewers. Any role the check constraint grows later still shows
// up (under its own raw name) rather than silently disappearing.
const ROLE_ORDER = ['owner', 'editor', 'viewer'];
const ROLE_LABELS: Record<string, string> = { owner: 'Owner', editor: 'Editors', viewer: 'Viewers' };

const roles = [...new Set(members.map((m) => m.role))].sort((a, b) => {
	const ai = ROLE_ORDER.indexOf(a);
	const bi = ROLE_ORDER.indexOf(b);
	return (ai === -1 ? ROLE_ORDER.length : ai) - (bi === -1 ? ROLE_ORDER.length : bi);
});

const memberGroups = roles.map((role) => ({
	role,
	label: ROLE_LABELS[role] ?? role,
	members: members.filter((m) => m.role === role),
}));

// Bounce the add-member POST back to whichever project page it was submitted
// from; safeReturnTo() in the endpoint re-checks it's an in-app /projects/ path.
const returnTo = Astro.url.pathname;
---

<aside class="project-sidebar">
	<p class="sidebar-title">{project.name}</p>

	<p class="sidebar-label">Members:</p>

	{isOwner ? (
		<MemberManager client:load projectId={project.id} members={memberData} />
	) : (
		<div class="member-groups">
			{memberGroups.map((group) => (
				<div class="member-group">
					<p class="group-label">{group.label}</p>
					<ul class="member-list">
						{group.members.map((m) => (
							<li class="member-row">
								{m.profiles?.display_name}{m.is_auditor && (<span class="capability"> [auditor]</span>)}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	)}

	{isOwner && (
		<form
			method="POST"
			action={`/api/projects/${project.id}/members`}
			class="add-member"
			data-add-member
			onsubmit="this.querySelector('button[type=submit]').disabled = true"
		>
			<input type="hidden" name="returnTo" value={returnTo} />

			<div class="add-panel">
				<div class="add-fields">
					<input type="email" name="email" placeholder="User's email" required />
					<select name="role">
						<option value="editor">Editor</option>
						<option value="viewer">Viewer</option>
					</select>
					<label class="auditor-toggle">
						<input type="checkbox" name="isAuditor" />
						Auditor (can edit Money)
					</label>
				</div>
			</div>

			<div class="add-actions">
				<button type="submit" data-add-submit>Add member</button>
				<button type="button" class="btn-plain" data-add-cancel hidden>Cancel</button>
			</div>
		</form>
	)}

	{isOwner && (
		/* Runs inline, right after the form is parsed, so the panel is folded before the
		   first paint (no flash) — and if the script never runs the form still works,
		   just permanently open. */
		<script is:inline>
			(() => {
				const form = document.currentScript.parentElement.querySelector('[data-add-member]');
				if (!form) return;

				const panel = form.querySelector('.add-panel');
				const cancel = form.querySelector('[data-add-cancel]');
				const fields = panel.querySelectorAll('input, select');

				function setOpen(open) {
					form.classList.toggle('open', open);
					cancel.hidden = !open;
					// Disabled while folded so the hidden `required` email can't block
					// submission or get tabbed into.
					fields.forEach((f) => (f.disabled = !open));
				}

				setOpen(false);

				form.querySelector('[data-add-submit]').addEventListener('click', (e) => {
					if (form.classList.contains('open')) return;
					e.preventDefault();
					setOpen(true);
					panel.querySelector('input[name=email]').focus();
				});

				cancel.addEventListener('click', () => setOpen(false));
			})();
		</script>
	)}

	<nav class="sidebar-nav">
		<a href={`/projects/${project.id}`} class={activePage === 'overview' ? 'active' : ''}>Overview</a>
		<a href={`/projects/${project.id}/files`} class={activePage === 'files' ? 'active' : ''}>Files</a>
		<a href={`/projects/${project.id}/money`} class={activePage === 'money' ? 'active' : ''}>Money</a>
	</nav>
</aside>

<style>
	.project-sidebar {
		flex: 0 0 240px;
		min-width: 0;
		position: sticky;
		top: var(--space-5);
		font-size: 0.85rem;
		align-self: flex-start;
	}

	.sidebar-title {
		font-weight: 700;
		font-size: 1rem;
		margin: 0 0 var(--space-2);
	}

	.sidebar-label {
		font-weight: 700;
		margin: 0 0 var(--space-2);
	}

	.member-groups {
		margin: 0 0 var(--space-3);
	}

	.member-group + .member-group {
		margin-top: var(--space-3);
	}

	.group-label {
		margin: 0 0 var(--space-1);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
	}

	.member-list {
		list-style: none;
		margin: 0;
		padding: 0;
		min-width: 0;
	}

	.member-row {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		margin-bottom: var(--space-1);
	}

	.capability {
		color: var(--color-muted);
	}

	.auditor-toggle {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		font-size: 0.8rem;
	}

	.auditor-toggle input {
		width: auto;
		flex: 0 0 auto;
	}

	/* Folded away by default so the member list, not the form, owns the sidebar's
	   vertical space — same 'Add …' toggle shape as the Money page panels: the
	   fields slide open above an actions row whose Add button never moves or
	   changes size, with Cancel appearing beside it only while open. */
	.add-member {
		display: block;
		margin: var(--space-3) 0 var(--space-4);
	}

	/* 0fr -> 1fr on a grid row is the CSS-only equivalent of Svelte's slide
	   transition; the inner wrapper does the clipping. */
	.add-panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 150ms ease;
	}

	.add-member.open .add-panel {
		grid-template-rows: 1fr;
	}

	.add-fields {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		min-height: 0;
		overflow: hidden;
	}

	.add-member.open .add-fields {
		padding-bottom: var(--space-2);
	}

	.add-actions {
		display: flex;
		gap: var(--space-2);
		align-items: center;
	}

	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-top: var(--space-7);
	}

	.sidebar-nav a {
		border-bottom: 1px solid transparent;
	}

	.sidebar-nav a.active {
		border-bottom-color: currentColor;
	}

	@media (max-width: 768px) {
		.project-sidebar {
			position: static;
			flex-basis: auto;
			width: 100%;
		}
	}
</style>
