---
interface Folder {
	id: string;
	name: string;
}

interface Props {
	projectId: string;
	subfolders: Folder[];
	currentFolderId: string | null;
	canEdit: boolean;
}

const { projectId, subfolders, currentFolderId, canEdit } = Astro.props;
---

{subfolders.length > 0 && (
	<ul class="list-plain folder-list">
		{subfolders.map((f) => (
			<li class="folder-row">
				<a href={`/projects/${projectId}?folder=${f.id}`}>📁 {f.name}</a>
				{canEdit && (
					<form method="POST" action={`/api/projects/${projectId}/folders/${f.id}/delete`}>
						<button type="submit" class="btn-danger">Delete</button>
					</form>
				)}
			</li>
		))}
	</ul>
)}

{canEdit && (
	<form method="POST" action={`/api/projects/${projectId}/folders/create`} onsubmit="this.querySelector('button').disabled = true">
		<input type="hidden" name="parentFolderId" value={currentFolderId ?? ''} />
		<input type="text" name="name" placeholder="New folder name" required />
		<button type="submit">Create folder</button>
	</form>
)}

<style>
	.folder-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.folder-row form {
		margin: 0;
	}
</style>
