---
import MyFilesModal from './MyFilesModal.svelte';
import StorageUsageFill from './StorageUsageFill.svelte';

interface Props {
	usedBytes: number;
	capBytes: number;
}

const { usedBytes, capBytes } = Astro.props;
---

<div class="storage-usage">
	<div class="storage-usage-label">
		<span class="storage-usage-title">Your storage used <MyFilesModal client:load /></span>
	</div>
	<StorageUsageFill client:load initialUsedBytes={usedBytes} capBytes={capBytes} />
</div>

<style>
	.storage-usage {
		margin: 0 0 var(--space-4);
		max-width: 480px;
	}

	.storage-usage-label {
		font-size: 0.85rem;
		color: var(--color-muted);
		margin-bottom: var(--space-1);
	}

	.storage-usage-title {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
	}
</style>
