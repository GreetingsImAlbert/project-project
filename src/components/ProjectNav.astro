---
import { publicProjectPath, type PublicSectionFlags } from '../lib/project-visibility';

interface Props {
	projectId: string;
	userRole: string;
	publicNav?: boolean;
	publicSections: PublicSectionFlags;
}

const {
	projectId,
	userRole,
	publicNav = false,
	publicSections = { overview: false, tasks: false, files: false, journal: false, money: false },
} = Astro.props;
const path = Astro.url.pathname;

const isOwner = userRole === 'owner';
const isEditorOrOwner = userRole === 'owner' || userRole === 'editor';

function isActive(page: string) {
	const base = `/projects/${projectId}`;
	if (page === 'overview') return path === base || path === base + '/';
	return path.startsWith(`${base}/${page}`);
}
---

<nav class="project-nav">
	{publicNav ? (
		<>
			{publicSections.overview && (
				<a href={publicProjectPath(projectId, 'overview')} class={isActive('overview') ? 'active' : ''} data-astro-prefetch>Overview</a>
			)}
			{publicSections.tasks && (
				<a href={publicProjectPath(projectId, 'tasks')} class={isActive('tasks') ? 'active' : ''} data-astro-prefetch>Tasks</a>
			)}
			{publicSections.files && (
				<a href={publicProjectPath(projectId, 'files')} class={isActive('files') ? 'active' : ''} data-astro-prefetch>Files</a>
			)}
			{publicSections.journal && (
				<a href={publicProjectPath(projectId, 'journal')} class={isActive('journal') ? 'active' : ''} data-astro-prefetch>Journal</a>
			)}
			{publicSections.money && (
				<a href={publicProjectPath(projectId, 'money')} class={isActive('money') ? 'active' : ''} data-astro-prefetch>Money</a>
			)}
		</>
	) : (
		<>
			<a href={publicProjectPath(projectId, 'overview')} class={isActive('overview') ? 'active' : ''} data-astro-prefetch>Overview</a>
			<a href={`/projects/${projectId}/tasks`} class={isActive('tasks') ? 'active' : ''} data-astro-prefetch>Tasks</a>
			<a href={`/projects/${projectId}/files`} class={isActive('files') ? 'active' : ''} data-astro-prefetch>Files</a>
			{(isEditorOrOwner || (userRole === 'viewer' && publicSections.journal)) && (
				<a href={`/projects/${projectId}/journal`} class={isActive('journal') ? 'active' : ''} data-astro-prefetch>Journal</a>
			)}
			<a href={`/projects/${projectId}/money`} class={isActive('money') ? 'active' : ''} data-astro-prefetch>Money</a>
			{isOwner && (
				<a href={`/projects/${projectId}/settings`} class={isActive('settings') ? 'active' : ''} data-astro-prefetch>Settings</a>
			)}
		</>
	)}
</nav>

<style>
	.project-nav {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2px;
		width: fit-content;
		max-width: 100%;
		padding: 0;
		background: transparent;
		margin-bottom: var(--space-7);
		margin-left: auto;
		margin-right: auto;
		flex-wrap: wrap;
	}

	.project-nav a {
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		padding: 6px var(--space-3);
		color: var(--color-muted);
		line-height: 1.4;
		white-space: nowrap;
		transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
	}

	.project-nav a:hover {
		background: var(--color-highlight);
		border-color: var(--color-border);
		color: var(--color-fg);
	}

	.project-nav a.active {
		background: var(--color-fg);
		border-color: var(--color-fg);
		color: var(--color-bg);
	}

	@media (max-width: 768px) {
		.project-nav {
			gap: 2px;
			margin-bottom: var(--space-4);
		}
	}
</style>
