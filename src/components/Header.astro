---
import ThemeToggle from './ThemeToggle.svelte';
import NavMenu from './NavMenu.svelte';

interface Props {
	user: { id: string; email: string | undefined; displayName: string | undefined; avatar: string | null } | null;
}
const { user } = Astro.props;
const isStaging = import.meta.env.MODE === 'staging';
---

<header class="site-header">
	<div class="site-header-inner">
		<a href="/" class="lockup" data-astro-prefetch>
			<span class="lockup-title-row">
				<span class="lockup-title">P2</span>
				{isStaging && <span class="environment-badge">STAGING</span>}
			</span>
			<span class="lockup-subtitle muted">Engineering Workspace</span>
		</a>

		<div class="header-right">
			<ThemeToggle client:idle />
			<NavMenu client:idle guest={!user} avatar={user?.avatar ?? null} displayName={user?.displayName ?? user?.email ?? ''} />
		</div>
	</div>
</header>

<style>
	.site-header {
		width: 100%;
		padding: var(--space-2) var(--space-2) 0;
		background: var(--color-frame);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		padding: var(--space-3) var(--space-6);
		max-width: var(--max-width);
		width: 100%;
		margin: 0 auto;
		background: var(--color-surface-header);
		border-radius: var(--radius-sm);
	}

	.lockup {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
		border-bottom: none;
		flex-shrink: 0;
	}

	.lockup:hover {
		border-bottom: none;
	}

	.lockup-title-row {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.lockup-title {
		font-weight: 700;
		font-size: 1.1rem;
	}

	.environment-badge {
		padding: 3px 6px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-highlight);
		color: var(--color-muted);
		font-size: 0.6rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1;
		white-space: nowrap;
	}

	.lockup-subtitle {
		font-size: 0.8rem;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-shrink: 0;
	}

	@media (min-width: 769px) {
		.site-header {
			padding: var(--space-2) var(--space-2) 0;
		}
	}

	@media (max-width: 768px) {
		.site-header-inner {
			padding: var(--space-2) var(--space-4);
		}
	}
</style>
