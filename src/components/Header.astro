---
interface Props {
	user: { id: string; email: string | undefined } | null;
}
const { user } = Astro.props;
const path = Astro.url.pathname;

const navLinks = [
	{ href: '/', label: 'Dashboard' },
	{ href: '/projects', label: 'Projects' },
];

function isActive(href: string) {
	if (href === '/') return path === '/';
	return path.startsWith(href);
}
---

<header class="site-header">
	<div class="container site-header-inner">
		<a href={user ? '/' : '/login'} class="lockup">
			<span class="lockup-title">P2</span>
			<span class="lockup-subtitle muted">Engineering workspace</span>
		</a>

		{user && (
			<nav class="site-nav">
				{navLinks.map((link) => (
					<a href={link.href} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
				))}
				<form method="POST" action="/api/auth/logout">
					<button type="submit" class="btn-plain">Log out</button>
				</form>
			</nav>
		)}
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
		margin-bottom: var(--space-6);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		padding-top: var(--space-5);
		padding-bottom: var(--space-5);
		flex-wrap: wrap;
	}

	.lockup {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
		border-bottom: none;
	}

	.lockup:hover {
		border-bottom: none;
	}

	.lockup-title {
		font-weight: 700;
		font-size: 1.1rem;
	}

	.lockup-subtitle {
		font-size: 0.8rem;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: var(--space-5);
	}

	.site-nav a {
		border-bottom: 1px solid transparent;
	}

	.site-nav a.active {
		border-bottom-color: currentColor;
	}

	.site-nav form {
		margin: 0;
	}

	.site-nav button {
		padding: var(--space-1) var(--space-3);
		font-size: 0.85rem;
	}
</style>