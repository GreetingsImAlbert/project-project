---
import ThemeToggle from './ThemeToggle.svelte';
import CurrencyPicker from './CurrencyPicker.svelte';

interface Props {
	user: { id: string; email: string | undefined; displayName: string | undefined } | null;
}
const { user } = Astro.props;
const path = Astro.url.pathname;

const navLinks = [
	{ href: '/', label: 'Dashboard' },
	{ href: '/projects', label: 'Projects' },
];

function isActive(href: string) {
	if (href === '/') return path === '/';
	return path.startsWith(href);
}
---

<header class="site-header">
	<div class="container site-header-inner">
		<a href={user ? '/' : '/login'} class="lockup">
			<span class="lockup-title">P2</span>
			<span class="lockup-subtitle muted">Engineering workspace</span>
		</a>

		<div class="header-right">
			{user && (
				<nav class="site-nav">
					{navLinks.map((link) => (
						<a href={link.href} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
					))}
				</nav>
			)}
			<ThemeToggle client:load />
			<CurrencyPicker client:load />
			{user && (
				<Fragment>
					<a
						href="/account"
						class:list={['site-user', { active: isActive('/account') }]}
						title={user.email}
						aria-label="Account settings"
					>
						<span class="site-user-name">{user.displayName ?? user.email}</span>
						<span class="site-user-arrow" aria-hidden="true">↗</span>
					</a>
					<!-- data-astro-reload: the ClientRouter otherwise submits this with fetch and
					     swaps in whatever comes back, which leaves the URL on /api/auth/logout
					     (a GET there is a 404) and keeps every module-scoped island store from
					     the signed-in session alive. An identity change wants a real document
					     load, so opt this form out of client-side routing. -->
					<form method="POST" action="/api/auth/logout" data-astro-reload>
						<button type="submit" class="btn-plain">Log out</button>
					</form>
				</Fragment>
			)}
		</div>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-border);
		margin-bottom: var(--space-6);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		padding-top: var(--space-5);
		padding-bottom: var(--space-5);
		flex-wrap: wrap;
	}

	.lockup {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
		border-bottom: none;
	}

	.lockup:hover {
		border-bottom: none;
	}

	.lockup-title {
		font-weight: 700;
		font-size: 1.1rem;
	}

	.lockup-subtitle {
		font-size: 0.8rem;
	}

	/* One row: nav links, theme toggle, currency, username, log out. Every child
	   is centered on the same horizontal centerline, so the text items and the
	   taller control boxes line up regardless of their individual heights. */
	.header-right {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		flex-wrap: wrap;
		min-width: 0;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: var(--space-5);
	}

	.site-nav a {
		border-bottom: 1px solid transparent;
		line-height: 1.4;
	}

	.site-nav a.active {
		border-bottom-color: currentColor;
	}

	/* The name is the link to /account, with a ↗ to say so — the arrow sits outside the
	   truncating span so a long name ellipsises without ever eating the affordance. */
	.site-user {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		flex: 0 1 auto;
		min-width: 0;
		max-width: 28ch;
		font-size: 0.8rem;
		line-height: 1.4;
		color: var(--color-muted);
		border-bottom: 1px solid transparent;
	}

	.site-user-name {
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.site-user-arrow {
		flex: 0 0 auto;
		font-size: 0.7rem;
	}

	.site-user:hover,
	.site-user.active {
		color: var(--color-fg);
		border-bottom-color: currentColor;
	}

	.header-right form {
		margin: 0;
	}

	.header-right form button {
		padding: var(--space-1) var(--space-2);
		font-size: 0.8rem;
	}

	@media (max-width: 640px) {
		.site-header-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-3);
			padding-top: var(--space-4);
			padding-bottom: var(--space-4);
		}

		.site-nav {
			gap: var(--space-4);
			flex-wrap: wrap;
		}
	}
</style>