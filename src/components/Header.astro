---
import ThemeToggle from './ThemeToggle.svelte';
import NavMenu from './NavMenu.svelte';

interface Props {
	user: { id: string; email: string | undefined; displayName: string | undefined } | null;
}
const { user } = Astro.props;
---

<header class="site-header">
	<div class="site-header-inner">
		<a href={user ? '/' : '/login'} class="lockup">
			<span class="lockup-title">P2</span>
			<span class="lockup-subtitle muted">Engineering Workspace</span>
		</a>

		<div class="header-right">
			<ThemeToggle client:load />
			{user && <NavMenu client:load />}
		</div>
	</div>
</header>

<style>
	.site-header {
		background: var(--color-surface-nav);
	}

	.site-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		padding: var(--space-3) var(--space-6);
		max-width: var(--max-width);
		margin: 0 auto;
		border-bottom: 1px solid var(--color-border);
	}

	.lockup {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
		border-bottom: none;
		flex-shrink: 0;
	}

	.lockup:hover {
		border-bottom: none;
	}

	.lockup-title {
		font-weight: 700;
		font-size: 1.1rem;
	}

	.lockup-subtitle {
		font-size: 0.8rem;
	}

	.header-right {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-shrink: 0;
	}

	@media (max-width: 768px) {
		.site-header-inner {
			padding: var(--space-2) var(--space-4);
		}
	}
</style>