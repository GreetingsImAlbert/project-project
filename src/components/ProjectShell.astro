---
import ProjectSidebar from './ProjectSidebar.astro';

interface Member {
	role: string;
	is_auditor: boolean;
	user_id: string;
	profiles: { display_name: string; email: string };
}

interface GhostMember {
	id: string;
	display_name: string;
}

interface Props {
	project: { id: string; name: string; description: string | null };
	members: Member[];
	ghostMembers: GhostMember[];
	userRole: string | undefined;
	activePage: 'overview' | 'tasks' | 'files' | 'journal' | 'money' | 'settings';
}

const { project, members, ghostMembers, userRole, activePage } = Astro.props;
---

<p><a href="/projects">← Back to projects</a></p>

<div class="project-shell">
	<ProjectSidebar
		project={project}
		members={members}
		ghostMembers={ghostMembers}
		userRole={userRole}
		activePage={activePage}
	/>

	<div class="project-main">
		<slot />
	</div>
</div>

<style>
	.project-shell {
		display: flex;
		gap: var(--space-6);
		align-items: flex-start;
	}

	.project-main {
		flex: 1;
		min-width: 0;
	}

	/* :global — slotted page content (Files/Money's own <h2>) is authored in a
	   different .astro file, so it doesn't carry this component's scoping
	   attribute and a scoped selector here would silently never match it. */
	:global(.project-main > h2:first-child) {
		margin-top: 0;
		padding-top: 0;
		border-top: none;
	}

	@media (max-width: 768px) {
		.project-shell {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
