---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import ProjectNav from '../components/ProjectNav.astro';
import AppSidebar from '../components/AppSidebar.svelte';
import GlobalFileViewer from '../components/GlobalFileViewer.svelte';
import Toasts from '../components/Toasts.svelte';

interface Props {
	title?: string;
	projectNav?: {
		projectId: string;
		userRole: string;
		readOnly?: boolean;
		publicFilesEnabled?: boolean;
	};
}
const { title = 'P2', projectNav } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const isStaging = Astro.url.hostname === 'p2testing.albertmendoza.com';

---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				try {
					var theme = localStorage.getItem('p2-theme');
					if (theme === 'dark' || theme === 'dim') {
						document.documentElement.setAttribute('data-theme', theme);
					}
					// Same reason as the theme above: AppSidebar hydrates after first paint, so
					// a pin read in the component would paint the folded rail first and expand
					// a frame later. The attribute is what the panel's CSS keys off, so it is
					// already correct in the very first frame.
					if (localStorage.getItem('p2-sidebar-pinned') === '1') {
						document.documentElement.setAttribute('data-sidebar-pinned', '');
					}
				} catch (e) {}

				document.addEventListener('astro:before-preparation', function () {
					document.documentElement.setAttribute('data-page-loading', '');
				});
				document.addEventListener('astro:after-swap', function () {
					document.documentElement.removeAttribute('data-page-loading');
				});

				document.addEventListener('astro:before-swap', function (ev) {
					var current = document.documentElement.getAttribute('data-theme');
					if (current) ev.newDocument.documentElement.setAttribute('data-theme', current);
					if (document.documentElement.hasAttribute('data-sidebar-pinned')) {
						ev.newDocument.documentElement.setAttribute('data-sidebar-pinned', '');
					}
					if (document.documentElement.hasAttribute('data-sidebar-navigating')) {
						ev.newDocument.documentElement.setAttribute('data-sidebar-navigating', '');
					}
					if (document.documentElement.hasAttribute('data-sidebar-mobile-open')) {
						ev.newDocument.documentElement.setAttribute('data-sidebar-mobile-open', '');
					}
					if (document.documentElement.hasAttribute('data-page-loading')) {
						ev.newDocument.documentElement.setAttribute('data-page-loading', '');
					}
				});
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{isStaging && <meta name="robots" content="noindex, nofollow" />}
		<title>{title} | P2</title>
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<Header user={user} />
		<div class="app-shell">
			<!-- Mounted for guests too: public files open in the same viewer, keyed under a
			     guest storage key since there is no user id to scope the tabs by. -->
			<GlobalFileViewer client:load transition:persist userId={user?.id} />
			<!-- Toasts are global because actions on several pages use the shared toast store. -->
			<Toasts client:load transition:persist />
			<AppSidebar
				client:idle
				transition:persist
				currentPath={path}
				displayName={user?.displayName ?? user?.email ?? ''}
				avatar={user?.avatar ?? null}
				guest={!user}
			/>
			<main class="app-main project-main">
				<div class="page-loading-indicator" role="status" aria-label="Loading"></div>
				{projectNav && (
					<ProjectNav projectId={projectNav.projectId} userRole={projectNav.userRole} readOnly={projectNav.readOnly} publicFilesEnabled={projectNav.publicFilesEnabled} />
				)}
				<slot />
			</main>
		</div>
		<script>
			import '../lib/client-error-report';
		</script>
	</body>
</html>

<style is:global>
	/* The sidebar scrolls independently of the content, so the shell has to be a fixed
	   viewport-height box rather than growing with the page — otherwise both columns
	   share the document scrollbar and the sidebar slides out of view. body becomes the
	   flex column that hands the shell whatever height is left under the header, so no
	   hardcoded header height is involved. */
	body:has(.app-shell) {
		display: flex;
		flex-direction: column;
		height: 100vh;
		overflow: hidden;
		background: var(--color-frame);
	}

	.app-shell {
		display: flex;
		flex: 1;
		min-height: 0;
		max-width: var(--max-width);
		width: 100%;
		margin: 0 auto;
		gap: var(--space-2);
		padding: var(--space-2);
		--sidebar-rail-width: 56px;
		--sidebar-panel-width: 280px;
	}

	/* Hover and pinned expansion reserve the same gutter, keeping page content visible
	   beside the open panel. */
	.app-shell:has(.sidebar-rail:hover) .app-main,
	.app-shell:has(.sidebar-rail:focus-within) .app-main,
	html[data-sidebar-pinned] .app-shell .app-main,
	html[data-sidebar-navigating] .app-shell .app-main {
		margin-left: calc(var(--sidebar-panel-width) - var(--sidebar-rail-width));
	}

	.app-main {
		flex: 1;
		min-width: 0;
		position: relative;
		background: var(--color-surface-content);
		border-radius: var(--radius-sm);
		overflow-y: auto;
		scrollbar-gutter: stable;
		padding: var(--space-7) var(--space-7) var(--space-8);
		transition: margin-left 0.18s ease;
	}

	.page-loading-indicator {
		position: absolute;
		top: var(--space-3);
		left: 50%;
		z-index: 1000;
		width: 16px;
		height: 16px;
		border: 2px solid var(--color-border);
		border-top-color: var(--color-fg);
		border-radius: 50%;
		pointer-events: none;
		visibility: hidden;
		opacity: 0;
		transform: translate(-50%, -4px);
		transition: opacity 0.12s ease, transform 0.12s ease, visibility 0.12s ease;
		animation: page-loading-spin 0.7s linear infinite;
	}

	html[data-page-loading] .page-loading-indicator {
		visibility: visible;
		opacity: 1;
		transform: translate(-50%, 0);
	}

	@keyframes page-loading-spin {
		to {
			transform: translate(-50%, 0) rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.page-loading-indicator {
			animation: none;
		}
	}

	/* The generous content gutter is what makes the app feel roomy, but below ~1200px it
	   starts eating the tables and BOM grids, so it steps back down before the sidebar
	   drops out entirely. */
	@media (max-width: 1200px) {
		.app-main {
			padding: var(--space-6) var(--space-5) var(--space-7);
		}
	}

	@media (max-width: 768px) {
		.app-shell {
			width: 100%;
		}

		.app-shell:has(.sidebar-rail:hover) .app-main,
		.app-shell:has(.sidebar-rail:focus-within) .app-main,
		html[data-sidebar-pinned] .app-shell .app-main,
		html[data-sidebar-navigating] .app-shell .app-main,
		.app-main {
			margin-left: 0;
		}
	}

	@media (min-width: 769px) {
		.app-shell {
			width: calc(100% - var(--space-4));
			padding: var(--space-2) 0 var(--space-3);
		}
	}

	@media (max-width: 640px) {
		.app-main {
			padding: var(--space-5) var(--space-4) var(--space-6);
		}
	}
</style>
