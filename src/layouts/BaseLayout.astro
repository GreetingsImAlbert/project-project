---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';

interface Props {
	title?: string;
}
const { title = 'P2' } = Astro.props;
const user = Astro.locals.user;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				try {
					var theme = localStorage.getItem('p2-theme');
					if (theme === 'dark' || theme === 'dim') {
						document.documentElement.setAttribute('data-theme', theme);
					}
				} catch (e) {}

				// data-theme is only ever set client-side, so no server response carries it.
				// ClientRouter's swap clears every attribute off <html> and re-copies them
				// from the fetched document, which would drop the theme on each navigation —
				// and this script won't re-run to restore it, since Astro marks scripts that
				// have already executed. Put it on the incoming document before the swap.
				document.addEventListener('astro:before-swap', function (ev) {
					var current = document.documentElement.getAttribute('data-theme');
					if (current) ev.newDocument.documentElement.setAttribute('data-theme', current);
				});
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | P2</title>
		<!-- fallback="swap", not "none": ClientRouter turns client-side routing off entirely
		     for browsers without view transitions when the fallback is "none", and those
		     browsers should still get the swap — just not the simulated fade that
		     "animate" (the default) would run. -->
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<Header user={user} />
		<main class="container">
			<slot />
		</main>
	</body>
</html>