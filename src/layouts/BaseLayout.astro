---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import ProjectNav from '../components/ProjectNav.astro';
import AppSidebar from '../components/AppSidebar.svelte';

interface Props {
	title?: string;
	projectNav?: {
		projectId: string;
		userRole: string;
	};
}
const { title = 'P2', projectNav } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;

type SidebarOwner = { displayName: string; avatar: string | null };
let sidebarProjects: { id: string; name: string; owner: SidebarOwner; taskCount: number }[] = [];
if (user) {
	// The owner's picture is the project's face in the sidebar — it's what the row
	// collapses down to when the sidebar is folded, so only the owner is fetched here
	// (the other members' pictures have nowhere left to go in a one-line row).
	// The task count is the reader's own open tasks in that project, same shape as the
	// dashboard reminders (index.astro): appointed to them, not done, not trashed.
	const [{ data }, { data: taskRows }] = await Promise.all([
		Astro.locals.supabase
			.from('projects')
			.select('id, name, owner_id, project_members(user_id, role, profiles(display_name, avatar))')
			.order('created_at', { ascending: false })
			.overrideTypes<{ id: string; name: string; owner_id: string; project_members: { user_id: string; role: string; profiles: { display_name: string; avatar: string | null } | null }[] }[]>(),
		Astro.locals.supabase
			.from('tasks')
			.select('project_id, task_assignees!inner(user_id)')
			.eq('task_assignees.user_id', user.id)
			.is('deleted_at', null)
			.neq('status', 'done')
			.overrideTypes<{ project_id: string }[]>(),
	]);

	const taskCounts = new Map<string, number>();
	for (const row of taskRows ?? []) {
		taskCounts.set(row.project_id, (taskCounts.get(row.project_id) ?? 0) + 1);
	}

	sidebarProjects = (data ?? []).map((p) => {
		const owner = (p.project_members ?? []).find((m) => m.user_id === p.owner_id)?.profiles ?? null;
		return {
			id: p.id,
			name: p.name,
			owner: {
				displayName: owner?.display_name ?? 'Unknown',
				avatar: owner?.avatar ?? null,
			},
			taskCount: taskCounts.get(p.id) ?? 0,
		};
	});
}
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				try {
					var theme = localStorage.getItem('p2-theme');
					if (theme === 'dark' || theme === 'dim') {
						document.documentElement.setAttribute('data-theme', theme);
					}
					// Same reason as the theme above: AppSidebar hydrates after first paint, so
					// a pin read in the component would paint the folded rail first and expand
					// a frame later. The attribute is what the panel's CSS keys off, so it is
					// already correct in the very first frame.
					if (localStorage.getItem('p2-sidebar-pinned') === '1') {
						document.documentElement.setAttribute('data-sidebar-pinned', '');
					}
				} catch (e) {}

				document.addEventListener('astro:before-swap', function (ev) {
					var current = document.documentElement.getAttribute('data-theme');
					if (current) ev.newDocument.documentElement.setAttribute('data-theme', current);
					if (document.documentElement.hasAttribute('data-sidebar-pinned')) {
						ev.newDocument.documentElement.setAttribute('data-sidebar-pinned', '');
					}
				});
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | P2</title>
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<Header user={user} />
		{user ? (
			<div class="app-shell">
				<AppSidebar
					client:load
					projects={sidebarProjects}
					currentPath={path}
					displayName={user.displayName ?? user.email ?? ''}
					avatar={user.avatar}
				/>
				<main class="app-main project-main">
					{projectNav && (
						<ProjectNav projectId={projectNav.projectId} userRole={projectNav.userRole} />
					)}
					<slot />
				</main>
			</div>
		) : (
			<main class="container">
				<slot />
			</main>
		)}
		<script>
			import '../lib/client-error-report';
		</script>
	</body>
</html>

<style is:global>
	/* The sidebar scrolls independently of the content, so the shell has to be a fixed
	   viewport-height box rather than growing with the page — otherwise both columns
	   share the document scrollbar and the sidebar slides out of view. body becomes the
	   flex column that hands the shell whatever height is left under the header, so no
	   hardcoded header height is involved. */
	body:has(.app-shell) {
		display: flex;
		flex-direction: column;
		height: 100vh;
		overflow: hidden;
		background: var(--color-surface-nav);
	}

	.app-shell {
		display: flex;
		flex: 1;
		min-height: 0;
		max-width: var(--max-width);
		width: 100%;
		margin: 0 auto;
	}

	.app-main {
		flex: 1;
		min-width: 0;
		background: var(--color-bg);
		overflow-y: auto;
		padding: var(--space-7) var(--space-7) var(--space-8);
	}

	/* The generous content gutter is what makes the app feel roomy, but below ~1200px it
	   starts eating the tables and BOM grids, so it steps back down before the sidebar
	   drops out entirely. */
	@media (max-width: 1200px) {
		.app-main {
			padding: var(--space-6) var(--space-5) var(--space-7);
		}
	}

	@media (max-width: 640px) {
		.app-main {
			padding: var(--space-5) var(--space-4) var(--space-6);
		}
	}
</style>